grations/connector-setup#enter-credentials","content":"Enter your credentials and save. They are stored locally in encrypted storage on your device."},"983":{"id":"/docs/integrations/connector-setup-21","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#enable-the-connector","content":"Toggle the connector on. Gent verifies that the required command (usually `npx`) is available and that the connector can start."},"984":{"id":"/docs/integrations/connector-setup-22","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#verifying-a-connector","content":"After enabling a connector, you can verify it works by:"},"985":{"id":"/docs/integrations/connector-setup-23","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#verifying-a-connector","content":"Opening a new **Agent Chat** tab"},"986":{"id":"/docs/integrations/connector-setup-24","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#verifying-a-connector","content":"Asking the agent to use a tool from that connector"},"987":{"id":"/docs/integrations/connector-setup-25","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#verifying-a-connector","content":"For example, with the GitHub connector enabled, ask: \"List my open pull requests.\" If the agent successfully calls the GitHub tools, the connector is working."},"988":{"id":"/docs/integrations/connector-setup-26","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#command-resolution","content":"Connectors typically run via `npx` (Node.js package runner). Gent resolves commands in this order:"},"989":{"id":"/docs/integrations/connector-setup-27","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#command-resolution","content":"**Bundled runtime** — Gent includes its own Node.js, so `npx` works without a system Node.js installation"},"990":{"id":"/docs/integrations/connector-setup-28","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#command-resolution","content":"**System PATH** — falls back to your system's Node.js if the bundled one is unavailable"},"991":{"id":"/docs/integrations/connector-setup-29","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#command-resolution","content":"You do not need Node.js installed on your system. Gent bundles a complete Node.js runtime on macOS, Windows, and Linux."},"992":{"id":"/docs/integrations/connector-setup-30","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#credential-storage","content":"Credentials are stored locally on your device using platform-native secure storage. They are never sent to any server — only passed as environment variables to the connector process running on your machine."},"993":{"id":"/docs/integrations/connector-setup-31","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#credential-storage","content":"To update or remove credentials, go back to the connector's settings page."},"994":{"id":"/docs/integrations/connector-setup-32","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#disabling-a-connector","content":"Toggle the connector off in Settings. The connector process stops, and the agent can no longer use its tools. Your credentials remain saved so you can re-enable it without re-entering them."},"995":{"id":"/docs/integrations/connector-setup-33","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#troubleshooting","content":"**Connector fails to start**: Check that no firewall or security tool is blocking the `npx` process"},"996":{"id":"/docs/integrations/connector-setup-34","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#troubleshooting","content":"**Tools not appearing in chat**: Restart the agent chat session after enabling a new connector"},"997":{"id":"/docs/integrations/connector-setup-35","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#troubleshooting","content":"**Authentication errors**: Verify your API key/token is correct and has the required permissions"},"998":{"id":"/docs/integrations/connector-setup-36","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#troubleshooting","content":"**Timeout errors**: Some connectors take a few seconds to initialize on first run as `npx` downloads the package"},"999":{"id":"/docs/integrations/custom-adapters","page_id":"/docs/integrations/custom-adapters","type":"page","content":"Custom Adapters","breadcrumbs":["Docs","Integrations"],"tags":[],"url":"/docs/integrations/custom-adapters"},"1000":{"id":"/docs/integrations/custom-adapters-0","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters","content":"Add support for a new AI coding CLI by writing a declarative adapter — no app build required."},"1001":{"id":"/docs/integrations/custom-adapters-1","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#how-it-works","content":"How it works"},"1002":{"id":"/docs/integrations/custom-adapters-2","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#pick-a-tier","content":"Pick a tier"},"1003":{"id":"/docs/integrations/custom-adapters-3","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#write-a-declarative-adapter","content":"Write a declarative adapter"},"1004":{"id":"/docs/integrations/custom-adapters-4","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#create-the-spec","content":"Create the spec"},"1005":{"id":"/docs/integrations/custom-adapters-5","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#install-it-with-add-adapter","content":"Install it with Add Adapter"},"1006":{"id":"/docs/integrations/custom-adapters-6","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#test-it","content":"Test it"},"1007":{"id":"/docs/integrations/custom-adapters-7","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"Models, effort, and slash commands"},"1008":{"id":"/docs/integrations/custom-adapters-8","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"Turning output into chat"},"1009":{"id":"/docs/integrations/custom-adapters-9","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#publish-to-the-registry","content":"Publish to the registry"},"1010":{"id":"/docs/integrations/custom-adapters-10","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#tips","content":"Tips"},"1011":{"id":"/docs/integrations/custom-adapters-11","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters","content":"Gent talks to AI coding CLIs (Claude Code, Codex, Copilot, …) through **adapters**. An\nadapter describes how to launch a CLI, what to show in its model / effort / slash-command\npickers, how to label its tools, and how to turn its output into Gent's chat. Most of an\nadapter is **data, not code** — so you can add a new CLI by writing a JSON file."},"1012":{"id":"/docs/integrations/custom-adapters-12","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters","content":"Custom adapters are part of Gent's runtime-extensible adapter system. This page documents\nthe authoring format; availability ships with the rollout of the new adapter engine."},"1013":{"id":"/docs/integrations/custom-adapters-13","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#how-it-works","content":"Two things are always true:"},"1014":{"id":"/docs/integrations/custom-adapters-14","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#how-it-works","content":"**The desktop host runs the adapter.** A paired phone is a viewer — it never spawns a\nCLI; it just mirrors what the host produces. Get it working on your Mac/PC and it works\non your phone automatically."},"1015":{"id":"/docs/integrations/custom-adapters-15","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#how-it-works","content":"**Pure-data adapters can't execute anything.** When a CLI genuinely needs parsing code,\nthat code runs in a sandbox (WASM) or as a signed first-party driver — never as\nunsandboxed downloaded code."},"1016":{"id":"/docs/integrations/custom-adapters-16","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#pick-a-tier","content":"How you build the adapter depends on how the CLI talks."},"1017":{"id":"/docs/integrations/custom-adapters-17","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#pick-a-tier","content":"<Card title=\"Declarative (most CLIs)\" description=\"The CLI prints a simple format (e.g. one JSON object per line). You write only a JSON spec. No app build.\" />"},"1018":{"id":"/docs/integrations/custom-adapters-18","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#pick-a-tier","content":"<Card title=\"Sandboxed WASM\" description=\"The CLI needs real parsing code. You ship a JSON spec plus a .wasm module that runs in a sandbox on the host. No app build.\" />"},"1019":{"id":"/docs/integrations/custom-adapters-19","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#pick-a-tier","content":"<Card title=\"Bundled driver\" description=\"Rare: a protocol needing full host trust. Requires a first-party code change shipped in an app release.\" />"},"1020":{"id":"/docs/integrations/custom-adapters-20","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#create-the-spec","content":"A complete, working adapter for a CLI that emits one JSON object per line:"},"1021":{"id":"/docs/integrations/custom-adapters-21","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#install-it-with-add-adapter","content":"Open **Add Adapter** in Gent, paste your adapter JSON (or a GitHub repo URL). Gent\nvalidates it and — if it spawns a command — shows you the exact command before anything\nruns. Approve to install."},"1022":{"id":"/docs/integrations/custom-adapters-22","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#test-it","content":"Start a new agent chat with your adapter selected and send a prompt. Your model picker,\ntools, and messages should appear just like a built-in CLI."},"1023":{"id":"/docs/integrations/custom-adapters-23","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"These are **catalogs** — lists that drive the pickers. The picker shows the `label`; the\n`id` is what gets sent to the CLI. Omit a catalog and its picker disappears."},"1024":{"id":"/docs/integrations/custom-adapters-24","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"When the user picks a model or effort, its `id` becomes the variable `{model}` / `{effort}`.\nYou choose where it goes — and that depends on the CLI:"},"1025":{"id":"/docs/integrations/custom-adapters-25","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"Most CLIs take model/effort as command-line arguments. Reference the variable in\n`spawn.args`. Changing the selection respawns the process."},"1026":{"id":"/docs/integrations/custom-adapters-26","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"`validValues` rejects an unknown effort; `when` skips the flag when nothing is selected."},"1027":{"id":"/docs/integrations/custom-adapters-27","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"CLIs like Codex/Copilot accept model/effort with each turn, so they can change\nmid-session without restarting. Set `perTurnSettings` and put the variables in the\nmessage template instead of the spawn args."},"1028":{"id":"/docs/integrations/custom-adapters-28","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"The `models` list is a fallback. If your CLI can report its real models at runtime, the\ndriver uses those and overrides the list."},"1029":{"id":"/docs/integrations/custom-adapters-29","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"The `parsing` rules run against each line of the CLI's output; the first match wins. The\nvocabulary is small on purpose — `match`, `extract`, `emit`, a shallow `setFlag`, and\n`escalate`:"},"1030":{"id":"/docs/integrations/custom-adapters-30","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"`match` — pick lines by JSON path, value, regex, or field presence."},"1031":{"id":"/docs/integrations/custom-adapters-31","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"`extract` — pull named fields (with ordered fallbacks)."},"1032":{"id":"/docs/integrations/custom-adapters-32","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"`emit` — produce a Gent event (`assistantDelta`, `toolStart`, `toolDone`, `turnComplete`, …)."},"1033":{"id":"/docs/integrations/custom-adapters-33","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"`escalate` — for anything stateful, hand off to a WASM or bundled driver instead of\ngrowing the rules."},"1034":{"id":"/docs/integrations/custom-adapters-34","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"If your CLI needs real, cross-line parsing logic, that's the cue for a **sandboxed WASM\nadapter** (`driver.type: \"wasm\"` with a hash-pinned module) rather than stretching the\ndeclarative rules."},"1035":{"id":"/docs/integrations/custom-adapters-35","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#publish-to-the-registry","content":"To share an adapter with everyone, open a pull request to &#x2A;*`mqtik/mate-adapters`** adding\nyour `specs/<id>.json` (and the `.wasm` for a WASM adapter). Once merged and signed, every\nGent install picks it up on the next refresh — no app update. Fixes ship as a new immutable\nversion, so rollback is a one-line change."},"1036":{"id":"/docs/integrations/custom-adapters-36","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"Namespace your `id`; the built-in `claude` / `codex` / `copilot` ids are protected."},"1037":{"id":"/docs/integrations/custom-adapters-37","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"Put every tool the CLI emits into `tools.categories`, or it shows up uncategorized."},"1038":{"id":"/docs/integrations/custom-adapters-38","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"Tool categories can tighten approval, never relax it — unknown tools always ask."},"1039":{"id":"/docs/integrations/custom-adapters-39","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"A bad or missing adapter degrades to a clear \"needs update\" state; it can't break the app."},"1040":{"id":"/docs/integrations/custom-adapters-40","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"See also: Custom Connectors for adding MCP servers\n(a different extension point — tools for an agent, rather than a new CLI)."},"1041":{"id":"/docs/integrations/custom-connectors","page_id":"/docs/integrations/custom-connectors","type":"page","content":"Custom Connectors","breadcrumbs":["Docs","Integrations"],"tags":[],"url":"/docs/integrations/custom-connectors"},"1042":{"id":"/docs/integrations/custom-connectors-0","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors","content":"Add your own MCP servers as connectors in Gent."},"1043":{"id":"/docs/integrations/custom-connectors-1","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#what-you-need","content":"What you need"},"1044":{"id":"/docs/integrations/custom-connectors-2","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#adding-a-custom-connector","content":"Adding a custom connector"},"1045":{"id":"/docs/integrations/custom-connectors-3","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#prepare-your-mcp-server","content":"Prepare your MCP server"},"1046":{"id":"/docs/integrations/custom-connectors-4","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#configure-in-gent","content":"Configure in Gent"},"1047":{"id":"/docs/integrations/custom-connectors-5","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#test-the-connector","content":"Test the connector"},"1048":{"id":"/docs/integrations/custom-connectors-6","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#examples","content":"Examples"},"1049":{"id":"/docs/integrations/custom-connectors-7","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#nodejs-mcp-server-via-npx","content":"Node.js MCP server via npx"},"1050":{"id":"/docs/integrations/custom-connectors-8","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#local-nodejs-script","content":"Local Node.js script"},"1051":{"id":"/docs/integrations/custom-connectors-9","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#python-mcp-server","content":"Python MCP server"},"1052":{"id":"/docs/integrations/custom-connectors-10","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#building-your-own-mcp-server","content":"Building your own MCP server"},"1053":{"id":"/docs/integrations/custom-connectors-11","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#sharing-connectors","content":"Sharing connectors"},"1054":{"id":"/docs/integrations/custom-connectors-12","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors","content":"Beyond the built-in connectors, you can add any MCP-compatible server as a custom connector. If you have built your own MCP server or want to use one from the community that is not in Gent's registry, you can configure it manually."},"1055":{"id":"/docs/integrations/custom-connectors-13","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"A custom connector requires:"},"1056":{"id":"/docs/integrations/custom-connectors-14","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"An **MCP server** that speaks the Model Context Protocol over stdio (stdin/stdout)"},"1057":{"id":"/docs/integrations/custom-connectors-15","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"A **command** to start it (e.g., `npx`, `node`, `python`, or a binary path)"},"1058":{"id":"/docs/integrations/custom-connectors-16","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"Any **arguments** the command needs"},"1059":{"id":"/docs/integrations/custom-connectors-17","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"Any **environment variables** for configuration (API keys, etc.)"},"1060":{"id":"/docs/integrations/custom-connectors-18","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#adding-a-custom-connector","content":"Custom connectors are configured as MCP servers that Gent passes to the agent CLI at startup."},"1061":{"id":"/docs/integrations/custom-connectors-19","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#prepare-your-mcp-server","content":"Make sure your server runs correctly from the command line. Test it independently first:"},"1062":{"id":"/docs/integrations/custom-connectors-20","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#configure-in-gent","content":"Add the connector configuration in Gent's settings. You will need to provide:"},"1063":{"id":"/docs/integrations/custom-connectors-21","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#configure-in-gent","content":"**Name**: A display name for the connector"},"1064":{"id":"/docs/integrations/custom-connectors-22","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-co