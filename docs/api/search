d":"/docs/features/agent-chat-24","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Yes (long-lived stdin)"},"774":{"id":"/docs/features/agent-chat-25","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Spawns process, sends messages via `--input-format stream-json`"},"775":{"id":"/docs/features/agent-chat-26","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Codex"},"776":{"id":"/docs/features/agent-chat-27","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"One-shot"},"777":{"id":"/docs/features/agent-chat-28","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Spawns a new process per message"},"778":{"id":"/docs/features/agent-chat-29","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Copilot"},"779":{"id":"/docs/features/agent-chat-30","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"One-shot"},"780":{"id":"/docs/features/agent-chat-31","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Spawns a new process per message"},"781":{"id":"/docs/features/agent-chat-32","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Claude Code keeps a persistent process running, so follow-up messages are instant. Codex and Copilot spawn fresh processes for each message, which takes a few seconds."},"782":{"id":"/docs/features/agent-chat-33","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Each CLI gives you access to different models:"},"783":{"id":"/docs/features/agent-chat-34","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"CLI"},"784":{"id":"/docs/features/agent-chat-35","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Models"},"785":{"id":"/docs/features/agent-chat-36","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Claude Code"},"786":{"id":"/docs/features/agent-chat-37","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Haiku 4.5, Sonnet 4.6, Opus 4.6"},"787":{"id":"/docs/features/agent-chat-38","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Codex"},"788":{"id":"/docs/features/agent-chat-39","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Codex Mini, GPT-5.2 Codex, o4-mini, o3"},"789":{"id":"/docs/features/agent-chat-40","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Copilot"},"790":{"id":"/docs/features/agent-chat-41","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"GPT-4o, Claude 3.5 Sonnet, o3-mini"},"791":{"id":"/docs/features/agent-chat-42","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Select your preferred model from the dropdown in the chat header. The model affects response quality, speed, and cost."},"792":{"id":"/docs/features/agent-chat-43","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#starting-a-chat","content":"Click &#x2A;*+** in the tab bar and select **Agent Chat**"},"793":{"id":"/docs/features/agent-chat-44","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#starting-a-chat","content":"Choose your CLI (Claude Code, Codex, or Copilot) from the dropdown"},"794":{"id":"/docs/features/agent-chat-45","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#starting-a-chat","content":"Type your message and press Enter"},"795":{"id":"/docs/features/agent-chat-46","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#starting-a-chat","content":"The agent streams its response in real time. You will see text output as it is generated, and tool use appears as interactive chips showing what the agent is doing."},"796":{"id":"/docs/features/agent-chat-47","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"When the agent calls tools — reading files, running commands, searching code — Gent shows each tool invocation with meaningful context:"},"797":{"id":"/docs/features/agent-chat-48","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"**Read file** shows the filename being read"},"798":{"id":"/docs/features/agent-chat-49","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"**Run command** shows the actual shell command"},"799":{"id":"/docs/features/agent-chat-50","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"**Search** shows the query being searched"},"800":{"id":"/docs/features/agent-chat-51","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"**Edit file** shows which file is being modified"},"801":{"id":"/docs/features/agent-chat-52","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"Tool calls that modify files (edits, writes) are highlighted so you can review what changed. Gent generates inline diffs for file modifications."},"802":{"id":"/docs/features/agent-chat-53","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-approval","content":"Some tools require your approval before the agent can execute them. When the agent wants to run a potentially destructive action (like writing a file or running a shell command), Gent shows a permission prompt. You can:"},"803":{"id":"/docs/features/agent-chat-54","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-approval","content":"**Approve** the individual tool call"},"804":{"id":"/docs/features/agent-chat-55","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-approval","content":"**Approve all** for that tool type during the session"},"805":{"id":"/docs/features/agent-chat-56","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-approval","content":"**Reject** to deny the action"},"806":{"id":"/docs/features/agent-chat-57","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#auto-approval-and-permission-modes","content":"For trusted workflows, you can configure auto-approval in the chat settings. This lets the agent run tools without asking — useful when you are watching the output and want a faster feedback loop. You can set permission modes per tool category (e.g., always approve file reads, always ask before shell commands)."},"807":{"id":"/docs/features/agent-chat-58","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#effort-level","content":"Claude Code supports an effort setting that controls how thorough the agent is. Lower effort means faster, more concise responses. Higher effort means the agent spends more time thinking, reading more files, and producing more detailed output. Adjust this in the chat header."},"808":{"id":"/docs/features/agent-chat-59","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"Each agent chat is a persistent conversation. You can:"},"809":{"id":"/docs/features/agent-chat-60","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"**Continue** a conversation by sending more messages"},"810":{"id":"/docs/features/agent-chat-61","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"**Fork** a conversation to branch off from a specific point — useful when you want to try a different approach without losing the original thread"},"811":{"id":"/docs/features/agent-chat-62","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"**Resume** a previous conversation from the sidebar"},"812":{"id":"/docs/features/agent-chat-63","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"Conversation history is stored locally on your desktop. Nothing is sent to any cloud service beyond what the underlying CLI itself sends to its API."},"813":{"id":"/docs/features/agent-chat-64","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#forking","content":"Conversation forking creates a new conversation that starts with the same history up to the point you forked. The original conversation is untouched. This lets you explore \"what if\" scenarios — try a different approach, and if it doesn't work out, go back to the original."},"814":{"id":"/docs/features/agent-chat-65","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#markdown-rendering","content":"Agent responses render full Markdown with syntax highlighting for code blocks, tables, lists, and inline formatting. Code blocks show the language label and can be copied with one click."},"815":{"id":"/docs/features/agent-chat-66","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#canvas-artifacts","content":"When an agent produces self-contained HTML/JS/CSS, Gent can display it in a Canvas panel alongside the chat. This is useful for visual content — charts, diagrams, interactive prototypes, games, and small tools — that the agent generates during the conversation. See Gent Canvas for the full workflow."},"816":{"id":"/docs/features/agent-chat-67","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#drawings-and-visual-prompts","content":"Gent Draw opens an Excalidraw board from the composer. You can sketch, paste images, annotate screenshots, reopen saved drawings, export the board, or send the drawing to the agent as a single PNG attachment. See Gent Draw."},"817":{"id":"/docs/features/agent-chat-68","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#file-and-image-attachments","content":"Drag and drop files or images into the composer, or paste them from your clipboard. The agent receives the file content as part of the message context. This works with code files, screenshots, logs, or any text-based content you want the agent to see."},"818":{"id":"/docs/features/agent-chat-69","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#slash-commands","content":"Type `/` in the composer to see available slash commands. These come from installed skills and built-in commands. Slash commands let you trigger specific workflows without typing out full prompts."},"819":{"id":"/docs/features/agent-chat-70","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#mcp-connectors-in-agent-chat","content":"If you have MCP connectors configured, the agent can use them as tools. For example, with the GitHub connector enabled, Claude Code can create pull requests, read issues, and manage repositories directly from chat."},"820":{"id":"/docs/features/agent-chat-71","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#mcp-connectors-in-agent-chat","content":"Gent generates an MCP config file that the CLI reads at startup, so all your connected integrations are available to the agent automatically."},"821":{"id":"/docs/features/agent-chat-72","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#remote-agent-chat","content":"Agent chat works from paired remote devices. When you select a remote device in the sidebar, you see its running agent chat sessions and can interact with them. The CLI process runs on the desktop — the remote device sends input and receives streamed output over the network."},"822":{"id":"/docs/features/agent-chat-73","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tips","content":"Long-running agent tasks keep working even if you switch to another tab"},"823":{"id":"/docs/features/agent-chat-74","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tips","content":"Use conversation forking when you want to try a different approach without losing the original thread"},"824":{"id":"/docs/features/agent-chat-75","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tips","content":"The agent respects your project's working directory when running commands"},"825":{"id":"/docs/features/agent-chat-76","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tips","content":"Use voice input to dictate prompts instead of typing"},"826":{"id":"/docs/features/canvas","page_id":"/docs/features/canvas","type":"page","content":"Gent Canvas","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/canvas"},"827":{"id":"/docs/features/canvas-0","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas","content":"Render agent-generated HTML, charts, prototypes, and interactive web artifacts beside chat."},"828":{"id":"/docs/features/canvas-1","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#what-canvas-is-for","content":"What Canvas is for"},"829":{"id":"/docs/features/canvas-2","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#starting-with-canvas","content":"Starting with `/canvas`"},"830":{"id":"/docs/features/canvas-3","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#file-mode-and-auto-reload","content":"File mode and auto-reload"},"831":{"id":"/docs/features/canvas-4","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#library-support","content":"Library support"},"832":{"id":"/docs/features/canvas-5","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#canvas-vs-web-preview","content":"Canvas vs Web Preview"},"833":{"id":"/docs/features/canvas-6","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#constraints","content":"Constraints"},"834":{"id":"/docs/features/canvas-7","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#related","content":"Related"},"835":{"id":"/docs/features/canvas-8","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas","content":"Gent Canvas gives agents a real web surface next to the conversation. When an agent needs to show something visual, it can call the built-in `mate-canvas` MCP tool and render a self-contained HTML document in the Canvas panel."},"836":{"id":"/docs/features/canvas-9","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas","content":"This is the web-agent surface in Gent: the agent writes the page, Gent renders it, and you can keep iterating without leaving the chat."},"837":{"id":"/docs/features/canvas-10","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Use Canvas when the output should be seen, touched, or inspected as a rendered web artifact:"},"838":{"id":"/docs/features/canvas-11","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Interactive prototypes and one-off UI mockups"},"839":{"id":"/docs/features/canvas-12","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Charts, dashboards, and data visualizations"},"840":{"id":"/docs/features/canvas-13","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Diagrams and system maps"},"841":{"id":"/docs/features/canvas-14","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Games, simulations, and small tools"},"842":{"id":"/docs/features/canvas-15","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"HTML/CSS/JS demos that benefit from live iteration"},"843":{"id":"/docs/features/canvas-16","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Canvas is not an image viewer. If an agent creates a PNG, SVG, JPEG, logo, screenshot, or icon file, it should attach or reference the file directly instead of opening it in Canvas."},"844":{"id":"/docs/features/canvas-17","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Type `/canvas` followed by what you want:"},"845":{"id":"/docs/features/canvas-18","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Gent rewrites that into a focused instruction for the agent:"},"846":{"id":"/docs/features/canvas-19","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Create a complete self-contained HTML file in the current working directory"},"847":{"id":"/docs/features/canvas-20","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Put CSS and JavaScript inline"},"848":{"id":"/docs/features/canvas-21","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Use CSS custom properties for important colors, fonts, and spacing"},"849":{"id":"/docs/features/canvas-22","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Call `mcp__mate-canvas__show` with the generated file"},"850":{"id":"/docs/features/canvas-23","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"The Canvas panel opens beside the chat when the tool call completes."},"851":{"id":"/docs/features/canvas-24","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#file-mode-and-auto-reload","content":"Canvas supports inline HTML, but Gent prefers file mode for iterative work. The agent writes a file such as `canvas-a1b2c3d4.html`, then calls the show tool with:"},"852":{"id":"/docs/features/canvas-25","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#file-mode-and-auto-reload","content":"Follow-up `/canvas` messages are applied to the same file when possible. The panel auto-reloads after edits, so the agent does not need to call the show tool again for every tiny change."},"853":{"id":"/docs/features/canvas-26","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Canvas can load browser libraries from CDNs when the HTML needs them. Good fits include:"},"854":{"id":"/docs/features/canvas-27","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Need"},"855":{"id":"/docs/features/canvas-28","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Examples"},"856":{"id":"/docs/features/canvas-29","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"3D scenes"},"857":{"id":"/docs/features/canvas-30","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Three.js, Babylon.js"},"858":{"id":"/docs/features/canvas-31","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Charts"},"859":{"id":"/docs/features/canvas-32","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"D3, Chart.js, Plotly, ECharts"},"860":{"id":"/docs/features/canvas-33","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Maps"},"861":{"id":"/docs/features/canvas-34","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Leaflet, MapLibre GL"},"862":{"id":"/docs/features/canvas-35","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Animation"},"863":{"id":"/docs/features/canvas-36","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"GSAP, anime.js, Lottie"},"864":{"id":"/docs/features/canvas-37","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Audio"},"865":{"id":"/docs/features/canvas-38","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Tone.js, Howler.js"},"866":{"id":"/docs/features/canvas-39","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Games and sketches"},"867":{"id":"/docs/features/canvas-40","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Phaser, p5.js, Matter.js"},"868":{"id":"/docs/features/canvas-41","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Diagrams"},"869":{"id":"/docs/features/canvas-42","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Mermaid, JointJS"},"870":{"id":"/docs/features/canvas-43","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Editors"},"871":{"id":"/docs/features/canvas-44","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Monaco Editor, CodeMirror"},"872":{"id":"/docs/features/canvas-45","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Agents should pin CDN versions instead of using `latest`, for example `three@0.160.0`."},"873":{"id":"/docs/features/canvas-46","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#canvas-vs-web-preview","content":"Canvas and Web Preview solve different problems:"},"874":{"id":"/docs/features/canvas-47","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#canvas-vs-web-preview","content":"Surface"},"875":{"id":"/docs/features/canvas-48","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#canvas-vs-web-preview","content":"Use it when"},"876":{"id":"/docs/features/canvas-49","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#canvas-vs-web-preview","content":"Gent Canvas"},"877":{"id":"/docs/features/canvas-50","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#canvas-vs-web-preview","content":"The agent is generating a self-contained web artifact directly in chat"},"878":{"id":"/docs/features/canvas-51","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#canvas-vs-web-preview","content":"Web Preview"},"879":{"id":"/docs/features/canvas-52","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#canvas-vs-web-preview","content":"You already have a dev server running on localhost and want to view it from Gent or a paired device"},"880":{"id":"/docs/features/canvas-53","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#canvas-vs-web-preview","content":"For app development, a common flow is: ask the agent to sketch an idea in Canvas, then move the real implementation into your project and use Web Preview to test the running app."},"881":{"id":"/docs/features/canvas-54","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#constraints","content":"Canvas has no backend, database, filesystem access, or server-side API"},"882":{"id":"/docs/features/canvas-55","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#constraints","content":"Everything must run in the browser"},"883":{"id":"/docs/features/canvas-56","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#constraints","content":"External dependencies should load from versioned CDN URLs"},"884":{"id":"/docs/features/canvas-57","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#constraints","content":"The current Canvas panel is attached to the current chat and replaces the previous Canvas artifact for that conversation"},"885":{"id":"/docs/features/canvas-58","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#related","content":"Agent Chat"},"886":{"id":"/docs/features/canvas-59","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#related","content":"Web Preview"},"887":{"id":"/docs/features/canvas-60","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#related","content":"Gent Draw"},"888":{"id":"/docs/features/draw","page_id":"/docs/features/draw","type":"page","content":"Gent Draw","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/draw"},"889":{"id":"/docs/features/draw-0","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw","content":"Sketch with Excalidraw, paste images, keep drawing history, export, and send one PNG to an agent."},"890":{"id":"/docs/features/draw-1","page_id":"/docs/features/draw","type":"heading","tags":[],"url":"/docs/features/draw#what-draw-is-good-for","content":"What Draw is good for"},"891":{"id":"/docs/features/draw-2","page_id":"/docs/features/draw","type":"heading","tags":[],"url":"/docs/features/draw#opening-draw","content":"Opening Draw"},"892":{"id":"/docs/features/draw-3","page_id":"/docs/features/draw","type":"heading","tags":[],"url":"/docs/features/draw#pasting-and-dropping-images","content":"Pasting and dropping images"},"893":{"id":"/docs/features/draw-4","page_id":"/docs/features/draw","type":"heading","tags":[],"url":"/docs/features/draw#sending-to-the-agent","content":"Sending to the agent"},"894":{"id":"/docs/features/draw-5","page_id":"/docs/features/draw","type":"heading","tags":[],"url":"/docs/features/draw#autosave-and-history","content":"Autosave and history"},"895":{"id":"/docs/features/draw-6","page_id":"/docs/features/draw","type":"heading","tags":[],"url":"/docs/features/draw#exporting-without-sending","content":"Exporting without sending"},"896":{"id":"/docs/features/draw-7","page_id":"/docs/features/draw","type":"heading","tags":[],"url":"/docs/features/draw#draw-vs-canvas","content":"Draw vs Canvas"},"897":{"id":"/docs/features/draw-8","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw","content":"Gent Draw is an Excalidraw-based drawing board inside agent chat. It is for the moments where a screenshot, rough diagram, annotated idea, or hand-drawn layout says more than a paragraph."},"898":{"id":"/docs/features/draw-9","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw","content":"You can draw, paste images, drop image files, reopen previous drawings, export the board, or send the whole drawing to the agent as a single PNG attachment."},"899":{"id":"/docs/features/draw-10","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#what-draw-is-good-for","content":"Annotating screenshots before asking an agent to fix a UI"},"900":{"id":"/docs/features/draw-11","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#what-draw-is-good-for","content":"Sketching a screen layout or state machine"},"901":{"id":"/docs/features/draw-12","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#what-draw-is-good-for","content":"Drawing arrows over an error, trace, or design reference"},"902":{"id":"/docs/features/draw-13","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#what-draw-is-good-for","content":"Combining pasted images with hand-written notes"},"903":{"id":"/docs/features/draw-14","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#what-draw-is-good-for","content":"Sending one compact visual brief instead of many separate files"},"904":{"id":"/docs/features/draw-15","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"In agent chat, use the drawing control in the composer. Gent opens a full drawing modal with an Excalidraw canvas and a small toolbar."},"905":{"id":"/docs/features/draw-16","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"The toolbar includes:"},"906":{"id":"/docs/features/draw-17","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"Control"},"907":{"id":"/docs/features/draw-18","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"What it does"},"908":{"id":"/docs/features/draw-19","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"Cancel"},"909":{"id":"/docs/features/draw-20","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"Close the modal without sending"},"910":{"id":"/docs/features/draw-21","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"History"},"911":{"id":"/docs/features/draw-22","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"Reopen saved drawings"},"912":{"id":"/docs/features/draw-23","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"Export"},"913":{"id":"/docs/features/draw-24","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"Save the current board as a PNG"},"914":{"id":"/docs/features/draw-25","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"Send"},"915":{"id":"/docs/features/draw-26","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#opening-draw","content":"Export the current board as a PNG and attach it to the agent message"},"916":{"id":"/docs/features/draw-27","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#pasting-and-dropping-images","content":"Draw supports image-heavy workflows:"},"917":{"id":"/docs/features/draw-28","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#pasting-and-dropping-images","content":"Paste an image from the clipboard"},"918":{"id":"/docs/features/draw-29","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#pasting-and-dropping-images","content":"Pick image files from disk"},"919":{"id":"/docs/features/draw-30","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#pasting-and-dropping-images","content":"Drag and drop image files into the canvas"},"920":{"id":"/docs/features/draw-31","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#pasting-and-dropping-images","content":"Supported image types include PNG, JPG, JPEG, GIF, WebP, SVG, and BMP. Images become Excalidraw image elements, so you can draw around them, resize them, and annotate them before sending."},"921":{"id":"/docs/features/draw-32","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#sending-to-the-agent","content":"When you click **Send**, Gent exports the current board as `image/png`, writes a temporary file, closes the drawing modal, and attaches that one PNG to the agent message."},"922":{"id":"/docs/features/draw-33","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#sending-to-the-agent","content":"This keeps the chat input simple: the agent receives one visual artifact that contains the sketch, pasted images, arrows, labels, and annotations together."},"923":{"id":"/docs/features/draw-34","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#autosave-and-history","content":"Draw autosaves non-empty scenes and stores a thumbnail for history. Use the History control to reopen previous drawings, continue editing them, or delete old entries."},"924":{"id":"/docs/features/draw-35","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#autosave-and-history","content":"Autosave stores the Excalidraw scene data so reopening a drawing keeps editable elements, not just a flat screenshot."},"925":{"id":"/docs/features/draw-36","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#exporting-without-sending","content":"Use **Export** when you want to save the drawing locally but not send it to the agent. Gent writes a PNG to the location you choose."},"926":{"id":"/docs/features/draw-37","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#draw-vs-canvas","content":"Surface"},"927":{"id":"/docs/features/draw-38","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#draw-vs-canvas","content":"Best for"},"928":{"id":"/docs/features/draw-39","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#draw-vs-canvas","content":"Gent Draw"},"929":{"id":"/docs/features/draw-40","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#draw-vs-canvas","content":"Human sketches, annotations, pasted screenshots, and visual prompts"},"930":{"id":"/docs/features/draw-41","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#draw-vs-canvas","content":"Gent Canvas"},"931":{"id":"/docs/features/draw-42","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#draw-vs-canvas","content":"Agent-generated HTML, charts, prototypes, demos, and interactive web artifacts"},"932":{"id":"/docs/features/draw-43","page_id":"/docs/features/draw","tags":[],"type":"text","url":"/docs/features/draw#draw-vs-canvas","content":"Use Draw when the human needs to communicate visually. Use Canvas when the agent needs to render something visual."},"933":{"id":"/docs/features/file-transfer","page_id":"/docs/features/file-transfer","type":"page","content":"File Transfer","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/file-transfer"},"934":{"id":"/docs/features/file-transfer-0","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer","content":"Send and receive files between paired devices."},"935":{"id":"/docs/features/file-transfer-1","page_id":"/docs/features/file-transfer","type":"heading","tags":[],"url":"/docs/features/file-transfer#sending-files","content":"Sending files"},"936":{"id":"/docs/features/file-transfer-2","page_id":"/docs/features/file-transfer","type":"heading","tags":[],"url":"/docs/features/file-transfer#open-the-send-tab","content":"Open the Send tab"},"937":{"id":"/docs/features/file-transfer-3","page_id":"/docs/features/file-transfer","type":"heading","tags":[],"url":"/docs/features/file-transfer#select-files","content":"Select files"},"938":{"id":"/docs/features/file-transfer-4","page_id":"/docs/features/file-transfer","type":"heading","tags":[],"url":"/docs/features/file-transfer#pick-a-destination","content":"Pick a destination"},"939":{"id":"/docs/features/file-transfer-5","page_id":"/docs/features/file-transfer","type":"heading","tags":[],"url":"/docs/features/file-transfer#send","content":"Send"},"940":{"id":"/docs/features/file-transfer-6","page_id":"/docs/features/file-transfer","type":"heading","tags":[],"url":"/docs/features/file-transfer#receiving-files","content":"Receiving files"},"941":{"id":"/docs/features/file-transfer-7","page_id":"/docs/features/file-transfer","type":"heading","tags":[],"url":"/docs/features/file-transfer#how-it-works","content":"How it works"},"942":{"id":"/docs/features/file-transfer-8","page_id":"/docs/features/file-transfer","type":"heading","tags":[],"url":"/docs/features/file-transfer#supported-file-types","content":"Supported file types"},"943":{"id":"/docs/features/file-transfer-9","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer","content":"Gent includes built-in file transfer between paired devices. Send files from your desktop to your phone, or receive files from your phone to your desktop — no third-party apps, cloud services, or cables needed."},"944":{"id":"/docs/features/file-transfer-10","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer#open-the-send-tab","content":"Navigate to the send interface in Gent."},"945":{"id":"/docs/features/file-transfer-11","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer#select-files","content":"Choose one or more files from your device. You can select multiple files at once."},"946":{"id":"/docs/features/file-transfer-12","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer#pick-a-destination","content":"Select the paired device you want to send to from the device list."},"947":{"id":"/docs/features/file-transfer-13","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer#send","content":"The files transfer directly over your local network. Large files transfer quickly since there is no cloud relay — data goes straight from device to device."},"948":{"id":"/docs/features/file-transfer-14","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer#receiving-files","content":"When a paired device sends you files, Gent notifies you and shows the incoming transfer. Received files are saved to your configured download location."},"949":{"id":"/docs/features/file-transfer-15","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer#how-it-works","content":"File transfers use the same direct TCP connection as all other Gent features. Files travel directly between devices on your local network with no intermediate server. Transfer speeds are limited only by your local network bandwidth — typically much faster than cloud-based alternatives."},"950":{"id":"/docs/features/file-transfer-16","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer#how-it-works","content":"File transfer works between any two paired devices: desktop to phone, phone to desktop, or desktop to desktop."},"951":{"id":"/docs/features/file-transfer-17","page_id":"/docs/features/file-transfer","tags":[],"type":"text","url":"/docs/features/file-transfer#supported-file-types","content":"Any file type is supported. There are no restrictions on what you can send — documents, images, videos, code archives, binaries, or anything else."},"952":{"id":"/docs/features/ide","page_id":"/docs/features/ide","type":"page","content":"IDE","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/ide"},"953":{"id":"/docs/features/ide-0","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide","content":"Built-in multi-file editor with file tree, git integration, and syntax highlighting."},"954":{"id":"/docs/features/ide-1","page_id":"/docs/features/ide","type":"heading","tags":[],"url":"/docs/features/ide#opening-the-ide","content":"Opening the IDE"},"955":{"id":"/docs/features/ide-2","page_id":"/docs/features/ide","type":"heading","tags":[],"url":"/docs/features/ide#file-tree","content":"File tree"},"956":{"id":"/docs/features/ide-3","page_id":"/docs/features/ide","type":"heading","tags":[],"url":"/docs/features/ide#editor","content":"Editor"},"957":{"id":"/docs/features/ide-4","page_id":"/docs/features/ide","type":"heading","tags":[],"url":"/docs/features/ide#single-file-editor","content":"Single-file editor"},"958":{"id":"/docs/features/ide-5","page_id":"/docs/features/ide","type":"heading","tags":[],"url":"/docs/features/ide#remote-editing","content":"Remote editing"},"959":{"id":"/docs/features/ide-6","page_id":"/docs/features/ide","type":"heading","tags":[],"url":"/docs/features/ide#file-browser","content":"File browser"},"960":{"id":"/docs/features/ide-7","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide","content":"Gent includes a built-in IDE for editing code without leaving the app. It is not a replacement for VS Code or JetBrains — it is a lightweight, always-available editor that is especially useful when you are working remotely from your phone or tablet."},"961":{"id":"/docs/features/ide-8","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#opening-the-ide","content":"Click &#x2A;*+** in the tab bar"},"962":{"id":"/docs/features/ide-9","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#opening-the-ide","content":"Select **IDE**"},"963":{"id":"/docs/features/ide-10","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#opening-the-ide","content":"Choose a folder to open"},"964":{"id":"/docs/features/ide-11","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#opening-the-ide","content":"The IDE shows a file tree on the left and an editor pane on the right. Click any file to open it."},"965":{"id":"/docs/features/ide-12","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#file-tree","content":"The file tree is git-aware. It uses `git ls-files` to list tracked files, which means it automatically respects your `.gitignore` and skips build artifacts, `node_modules`, and other ignored directories. For non-git projects, it falls back to a standard directory listing."},"966":{"id":"/docs/features/ide-13","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#file-tree","content":"You can:"},"967":{"id":"/docs/features/ide-14","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#file-tree","content":"Navigate folders by expanding/collapsing them"},"968":{"id":"/docs/features/ide-15","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#file-tree","content":"Open files by clicking"},"969":{"id":"/docs/features/ide-16","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#file-tree","content":"Search files by name using the search bar at the top of the tree"},"970":{"id":"/docs/features/ide-17","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#editor","content":"The editor supports syntax highlighting for 100+ languages through the re\\_editor package. Features include:"},"971":{"id":"/docs/features/ide-18","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#editor","content":"Syntax highlighting with language auto-detection based on file extension"},"972":{"id":"/docs/features/ide-19","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#editor","content":"Line numbers"},"973":{"id":"/docs/features/ide-20","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#editor","content":"Find and replace"},"974":{"id":"/docs/features/ide-21","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#editor","content":"Undo/redo"},"975":{"id":"/docs/features/ide-22","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#editor","content":"Standard keyboard shortcuts for editing"},"976":{"id":"/docs/features/ide-23","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#editor","content":"The IDE is designed for quick edits and code review, not as a full development environment. For heavy editing sessions, pair it with your preferred desktop editor and use Gent's IDE for on-the-go changes."},"977":{"id":"/docs/features/ide-24","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#single-file-editor","content":"If you just need to edit one file without a full project tree, use the **Editor** tab type instead. It opens a single file in an editor with the same syntax highlighting and editing features."},"978":{"id":"/docs/features/ide-25","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#remote-editing","content":"The IDE works from paired remote devices. When you open an IDE tab on a remote session, you are browsing and editing files on the desktop. Changes are saved directly to the desktop's filesystem."},"979":{"id":"/docs/features/ide-26","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#remote-editing","content":"This is particularly useful for:"},"980":{"id":"/docs/features/ide-27","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#remote-editing","content":"Quick fixes from your phone while away from your desk"},"981":{"id":"/docs/features/ide-28","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#remote-editing","content":"Reviewing code that an AI agent just modified"},"982":{"id":"/docs/features/ide-29","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#remote-editing","content":"Editing configuration files on a remote machine"},"983":{"id":"/docs/features/ide-30","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#file-browser","content":"The file browser modal lets you navigate your filesystem to find files or folders. It supports:"},"984":{"id":"/docs/features/ide-31","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#file-browser","content":"Breadcrumb navigation"},"985":{"id":"/docs/features/ide-32","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#file-browser","content":"Quick search with fuzzy matching"},"986":{"id":"/docs/features/ide-33","page_id":"/docs/features/ide","tags":[],"type":"text","url":"/docs/features/ide#file-browser","content":"Git-aware file listing that filters out ignored files"},"987":{"id":"/docs/features/orchestrator","page_id":"/docs/features/orchestrator","type":"page","content":"Orchestrator","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/orchestrator"},"988":{"id":"/docs/features/orchestrator-0","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator","content":"Run multiple AI agents in parallel with the multi-agent orchestrator."},"989":{"id":"/docs/features/orchestrator-1","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#how-it-works","content":"How it works"},"990":{"id":"/docs/features/orchestrator-2","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#use-cases","content":"Use cases"},"991":{"id":"/docs/features/orchestrator-3","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#creating-a-run","content":"Creating a run"},"992":{"id":"/docs/features/orchestrator-4","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#open-the-orchestrator","content":"Open the Orchestrator"},"993":{"id":"/docs/features/orchestrator-5","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#define-your-tasks","content":"Define your tasks"},"994":{"id":"/docs/features/orchestrator-6","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#start-the-run","content":"Start the run"},"995":{"id":"/docs/features/orchestrator-7","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#monitor-and-review","content":"Monitor and review"},"996":{"id":"/docs/features/orchestrator-8","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#task-states","content":"Task states"},"997":{"id":"/docs/features/orchestrator-9","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#concurrency","content":"Concurrency"},"998":{"id":"/docs/features/orchestrator-10","page_id":"/docs/features/orchestrator","type":"heading","tags":[],"url":"/docs/features/orchestrator#retries","content":"Retries"},"999":{"id":"/docs/features/orchestrator-11","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator","content":"The Orchestrator lets you run multiple AI agent sessions in parallel, coordinated by a plan. Instead of sending tasks to one agent at a time, you define a set of tasks and the orchestrator distributes them across concurrent agent sessions, tracks progress, and handles retries."},"1000":{"id":"/docs/features/orchestrator-12","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#how-it-works","content":"The orchestrator follows a straightforward model:"},"1001":{"id":"/docs/features/orchestrator-13","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#how-it-works","content":"**Define tasks** — describe what needs to be done, broken into independent units of work"},"1002":{"id":"/docs/features/orchestrator-14","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#how-it-works","content":"**Create a run** — the orchestrator schedules tasks and assigns them to agent sessions"},"1003":{"id":"/docs/features/orchestrator-15","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#how-it-works","content":"**Monitor progress** — watch as agents work in parallel, with real-time status updates"},"1004":{"id":"/docs/features/orchestrator-16","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#how-it-works","content":"**Review results** — see what each agent accomplished when the run completes"},"1005":{"id":"/docs/features/orchestrator-17","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#how-it-works","content":"Each task runs in its own agent chat session. The orchestrator manages the lifecycle — starting sessions, sending prompts, monitoring for completion, and handling failures with automatic retries."},"1006":{"id":"/docs/features/orchestrator-18","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#use-cases","content":"**Large refactors**: Split a codebase-wide change into file-by-file or module-by-module tasks"},"1007":{"id":"/docs/features/orchestrator-19","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#use-cases","content":"**Parallel code reviews**: Have multiple agents review different parts of a PR simultaneously"},"1008":{"id":"/docs/features/orchestrator-20","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#use-cases","content":"**Batch operations**: Run the same type of task across many files or repositories"},"1009":{"id":"/docs/features/orchestrator-21","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#use-cases","content":"**Testing campaigns**: Generate tests for multiple modules in parallel"},"1010":{"id":"/docs/features/orchestrator-22","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#open-the-orchestrator","content":"Click &#x2A;*+** in the tab bar and select **Orchestrator**."},"1011":{"id":"/docs/features/orchestrator-23","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#define-your-tasks","content":"Add tasks with descriptions of what each agent should do. Each task should be independent — agents work in parallel without knowledge of what other agents are doing."},"1012":{"id":"/docs/features/orchestrator-24","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#start-the-run","content":"The orchestrator creates agent chat sessions for each task and begins execution. You can watch progress in real time."},"1013":{"id":"/docs/features/orchestrator-25","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#monitor-and-review","content":"Each task shows its status: pending, running, completed, or failed. Failed tasks are retried automatically with exponential backoff."},"1014":{"id":"/docs/features/orchestrator-26","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#monitor-and-review","content":"Tasks should be independent units of work. The orchestrator runs them in parallel, so tasks that depend on each other's output will not work well. Design your tasks so each agent can work without waiting for another."},"1015":{"id":"/docs/features/orchestrator-27","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"State"},"1016":{"id":"/docs/features/orchestrator-28","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"Meaning"},"1017":{"id":"/docs/features/orchestrator-29","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"Pending"},"1018":{"id":"/docs/features/orchestrator-30","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"Queued, waiting for an available agent session"},"1019":{"id":"/docs/features/orchestrator-31","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"Running"},"1020":{"id":"/docs/features/orchestrator-32","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"An agent is actively working on this task"},"1021":{"id":"/docs/features/orchestrator-33","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"Completed"},"1022":{"id":"/docs/features/orchestrator-34","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"The agent finished successfully"},"1023":{"id":"/docs/features/orchestrator-35","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"Failed"},"1024":{"id":"/docs/features/orchestrator-36","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#task-states","content":"The task failed — will be retried up to the configured limit"},"1025":{"id":"/docs/features/orchestrator-37","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#concurrency","content":"The orchestrator manages how many agent sessions run simultaneously. This prevents overwhelming your machine with too many concurrent CLI processes. Tasks that exceed the concurrency limit are queued and start as earlier tasks complete."},"1026":{"id":"/docs/features/orchestrator-38","page_id":"/docs/features/orchestrator","tags":[],"type":"text","url":"/docs/features/orchestrator#retries","content":"When a task fails, the orchestrator retries it with exponential backoff. This handles transient issues like API rate limits or temporary network errors. You can configure the maximum number of retries per task."},"1027":{"id":"/docs/features/projects","page_id":"/docs/features/projects","type":"page","content":"Projects","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/projects"},"1028":{"id":"/docs/features/projects-0","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects","content":"Organize terminals, editors, and agent chats into project workspaces."},"1029":{"id":"/docs/features/projects-1","page_id":"/docs/features/projects","type":"heading","tags":[],"url":"/docs/features/projects#creating-a-project","content":"Creating a project"},"1030":{"id":"/docs/features/projects-2","page_id":"/docs/features/projects","type":"heading","tags":[],"url":"/docs/features/projects#what-projects-contain","content":"What projects contain"},"1031":{"id":"/docs/features/projects-3","page_id":"/docs/features/projects","type":"heading","tags":[],"url":"/docs/features/projects#working-directory","content":"Working directory"},"1032":{"id":"/docs/features/projects-4","page_id":"/docs/features/projects","type":"heading","tags":[],"url":"/docs/features/projects#switching-between-projects","content":"Switching between projects"},"1033":{"id":"/docs/features/projects-5","page_id":"/docs/features/projects","type":"heading","tags":[],"url":"/docs/features/projects#when-to-use-projects","content":"When to use projects"},"1034":{"id":"/docs/features/projects-6","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects","content":"Projects let you group related sessions together. Instead of having a flat list of terminal tabs, editor tabs, and agent chats, you can organize them by project — keeping your frontend work separate from your backend work, or your personal projects separate from work."},"1035":{"id":"/docs/features/projects-7","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#creating-a-project","content":"Click &#x2A;*+** in the tab bar"},"1036":{"id":"/docs/features/projects-8","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#creating-a-project","content":"Select **Project**"},"1037":{"id":"/docs/features/projects-9","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#creating-a-project","content":"Choose a working directory for the project"},"1038":{"id":"/docs/features/projects-10","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#creating-a-project","content":"The project opens as a container tab. Inside it, you can create terminals, editors, and agent chats that are scoped to that project's directory."},"1039":{"id":"/docs/features/projects-11","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#what-projects-contain","content":"A project can hold:"},"1040":{"id":"/docs/features/projects-12","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#what-projects-contain","content":"**Terminals** that start in the project's working directory"},"1041":{"id":"/docs/features/projects-13","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#what-projects-contain","content":"**Agent chats** scoped to the project's codebase"},"1042":{"id":"/docs/features/projects-14","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#what-projects-contain","content":"**IDE tabs** that open the project's folder"},"1043":{"id":"/docs/features/projects-15","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#what-projects-contain","content":"**Web previews** for dev servers running in the project"},"1044":{"id":"/docs/features/projects-16","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#working-directory","content":"Every session created within a project inherits the project's working directory. When you open a new terminal inside a project, it starts in the project root. When you start an agent chat, the AI assistant has context about the project's files."},"1045":{"id":"/docs/features/projects-17","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#working-directory","content":"This means you do not need to `cd` into your project directory every time you open a new terminal — the project handles that for you."},"1046":{"id":"/docs/features/projects-18","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#switching-between-projects","content":"Projects appear as tabs in the main tab bar, just like terminals and editors. Click a project tab to switch to it and see its sessions."},"1047":{"id":"/docs/features/projects-19","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#switching-between-projects","content":"Projects are a local organizational tool. They do not create any files in your project directory or modify your repository in any way."},"1048":{"id":"/docs/features/projects-20","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#when-to-use-projects","content":"Projects are most useful when you are working on multiple codebases at once. Instead of managing a sea of unlabeled terminal tabs, you can group everything by context:"},"1049":{"id":"/docs/features/projects-21","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#when-to-use-projects","content":"**Monorepo work**: One project for the frontend, another for the backend, another for infrastructure"},"1050":{"id":"/docs/features/projects-22","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#when-to-use-projects","content":"**Multi-repo development**: Separate projects for related but distinct repositories"},"1051":{"id":"/docs/features/projects-23","page_id":"/docs/features/projects","tags":[],"type":"text","url":"/docs/features/projects#when-to-use-projects","content":"**Context switching**: Keep your side project's sessions separate from your work sessions"},"1052":{"id":"/docs/features/terminal","page_id":"/docs/features/terminal","type":"page","content":"Terminal","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/terminal"},"1053":{"id":"/docs/features/terminal-0","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal","content":"Full PTY terminal emulation with tabs, scrollback, and remote access."},"1054":{"id":"/docs/features/terminal-1","page_id":"/docs/features/terminal","type":"heading","tags":[],"url":"/docs/features/terminal#local-terminals","content":"Local terminals"},"1055":{"id":"/docs/features/terminal-2","page_id":"/docs/features/terminal","type":"heading","tags":[],"url":"/docs/features/terminal#what-works","content":"What works"},"1056":{"id":"/docs/features/terminal-3","page_id":"/docs/features/terminal","type":"heading","tags":[],"url":"/docs/features/terminal#remote-terminals","content":"Remote terminals"},"1057":{"id":"/docs/features/terminal-4","page_id":"/docs/features/terminal","type":"heading","tags":[],"url":"/docs/features/terminal#working-with-multiple-terminals","content":"Working with multiple terminals"},"1058":{"id":"/docs/features/terminal-5","page_id":"/docs/features/terminal","type":"heading","tags":[],"url":"/docs/features/terminal#terminal-within-projects","content":"Terminal within projects"},"1059":{"id":"/docs/features/terminal-6","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal","content":"Gent's terminal is a real PTY shell — not a simplified command runner. It uses full xterm emulation backed by a native PTY, so everything you expect from a terminal works: colors, cursor addressing, interactive programs, shell completion, and full Unicode support."},"1060":{"id":"/docs/features/terminal-7","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#local-terminals","content":"A local terminal runs your default shell (zsh, bash, fish, or whatever you have configured) directly on the machine. Each terminal tab is an independent session with its own working directory and environment."},"1061":{"id":"/docs/features/terminal-8","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#local-terminals","content":"You can open as many terminal tabs as you need. Each one is a separate shell process."},"1062":{"id":"/docs/features/terminal-9","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#what-works","content":"Full ANSI color and formatting (256-color and truecolor)"},"1063":{"id":"/docs/features/terminal-10","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#what-works","content":"Interactive programs: `vim`, `nano`, `top`, `htop`, `less`, and more"},"1064":{"id":"/docs/features/terminal-11","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#what-works","content":"Shell features: tab completion, history, aliases, custom prompts"},"1065":{"id":"/docs/features/terminal-12","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#what-works","content":"Mouse support in programs that use it"},"1066":{"id":"/docs/features/terminal-13","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#what-works","content":"Scrollback buffer for reviewing previous output"},"1067":{"id":"/docs/features/terminal-14","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#what-works","content":"Copy and paste with standard keyboard shortcuts"},"1068":{"id":"/docs/features/terminal-15","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#remote-terminals","content":"When you select a paired remote device in the sidebar, terminal tabs show that device's sessions. Remote terminals connect over WebSocket and behave identically to local ones — same PTY, same scrollback, same interactive program support."},"1069":{"id":"/docs/features/terminal-16","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#remote-terminals","content":"From a remote device (like your phone), you can:"},"1070":{"id":"/docs/features/terminal-17","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#remote-terminals","content":"View and interact with terminals running on the desktop"},"1071":{"id":"/docs/features/terminal-18","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#remote-terminals","content":"Create new terminal sessions on the desktop"},"1072":{"id":"/docs/features/terminal-19","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#remote-terminals","content":"Use the same shell with full input support"},"1073":{"id":"/docs/features/terminal-20","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#remote-terminals","content":"Remote terminal sessions are owned by the desktop. Creating a terminal from your phone actually creates it on the paired desktop — your phone is just the viewer and controller."},"1074":{"id":"/docs/features/terminal-21","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#working-with-multiple-terminals","content":"The tab bar shows all open terminals. You can:"},"1075":{"id":"/docs/features/terminal-22","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#working-with-multiple-terminals","content":"**Open** a new terminal with the + button or keyboard shortcut"},"1076":{"id":"/docs/features/terminal-23","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#working-with-multiple-terminals","content":"**Switch** between terminals by clicking tabs or using keyboard shortcuts"},"1077":{"id":"/docs/features/terminal-24","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#working-with-multiple-terminals","content":"**Reorder** tabs by dragging"},"1078":{"id":"/docs/features/terminal-25","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#working-with-multiple-terminals","content":"**Close** a terminal by clicking the tab's X button"},"1079":{"id":"/docs/features/terminal-26","page_id":"/docs/features/terminal","tags":[],"type":"text","url":"/docs/features/terminal#terminal-within-projects","content":"Terminals can be organized inside Projects. When you create a terminal within a project, it starts in the project's working directory and is grouped with the project's other sessions."},"1080":{"id":"/docs/features/voice-input","page_id":"/docs/features/voice-input","type":"page","content":"Voice Input","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/voice-input"},"1081":{"id":"/docs/features/voice-input-0","page_id":"/docs/features/voice-input","tags":[],"type":"text","url":"/docs/features/voice-input","content":"Talk instead of type with built-in speech-to-text."},"1082":{"id":"/docs/features/voice-input-1","page_id":"/docs/features/voice-input","type":"heading","tags":[],"url":"/docs/features/voice-input#stt-engines","content":"STT Engines"},"1083":{"id":"/docs/features/voice-input-2","page_id":"/docs/features/voice-input","type":"heading","tags":[],"url":"/docs/features/voice-input#native","content":"Native"},"1084":{"id":"/docs/features/voice-input-3","page_id":"/docs/features/voice-input","type":"heading","tags":[],"url":"/docs/features/voice-input#whisper","content":"Whisper"},"1085":{"id":"/docs/features/voice-input-4","page_id":"/docs/features/voice-input","type":"heading","tags":[],"url"