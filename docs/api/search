etting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#install-by-platform","content":"Run the `mate` binary from the extracted folder"},"527":{"id":"/docs/getting-started/installation-38","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#install-by-platform","content":"Node.js is bundled with the app"},"528":{"id":"/docs/getting-started/installation-39","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#mobile-apps","content":"iOS and Android apps are available for pairing with a desktop running Gent. Mobile devices act as remote mirrors — they connect to your desktop over the local network and let you interact with your sessions from your phone or tablet."},"529":{"id":"/docs/getting-started/installation-40","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#mobile-apps","content":"Mobile devices do not run terminals or AI agents locally. They connect to a paired desktop that does the heavy lifting. See Pairing Devices for setup instructions."},"530":{"id":"/docs/getting-started/installation-41","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#verify-the-installation","content":"After launching Gent, you should see the workspace with a default terminal tab. Try typing a command to confirm everything works:"},"531":{"id":"/docs/getting-started/installation-42","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#verify-the-installation","content":"If the terminal responds, you are good to go. Head to First Session to learn the basics."},"532":{"id":"/docs/getting-started/pairing-devices","page_id":"/docs/getting-started/pairing-devices","type":"page","content":"Pairing Devices","breadcrumbs":["Docs","Getting Started"],"tags":[],"url":"/docs/getting-started/pairing-devices"},"533":{"id":"/docs/getting-started/pairing-devices-0","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices","content":"Pair your phone or another computer with Gent over your local network."},"534":{"id":"/docs/getting-started/pairing-devices-1","page_id":"/docs/getting-started/pairing-devices","type":"heading","tags":[],"url":"/docs/getting-started/pairing-devices#how-pairing-works","content":"How pairing works"},"535":{"id":"/docs/getting-started/pairing-devices-2","page_id":"/docs/getting-started/pairing-devices","type":"heading","tags":[],"url":"/docs/getting-started/pairing-devices#launch-gent-on-both-devices","content":"Launch Gent on both devices"},"536":{"id":"/docs/getting-started/pairing-devices-3","page_id":"/docs/getting-started/pairing-devices","type":"heading","tags":[],"url":"/docs/getting-started/pairing-devices#wait-for-discovery","content":"Wait for discovery"},"537":{"id":"/docs/getting-started/pairing-devices-4","page_id":"/docs/getting-started/pairing-devices","type":"heading","tags":[],"url":"/docs/getting-started/pairing-devices#tap-to-pair","content":"Tap to pair"},"538":{"id":"/docs/getting-started/pairing-devices-5","page_id":"/docs/getting-started/pairing-devices","type":"heading","tags":[],"url":"/docs/getting-started/pairing-devices#what-paired-devices-can-do","content":"What paired devices can do"},"539":{"id":"/docs/getting-started/pairing-devices-6","page_id":"/docs/getting-started/pairing-devices","type":"heading","tags":[],"url":"/docs/getting-started/pairing-devices#network-requirements","content":"Network requirements"},"540":{"id":"/docs/getting-started/pairing-devices-7","page_id":"/docs/getting-started/pairing-devices","type":"heading","tags":[],"url":"/docs/getting-started/pairing-devices#troubleshooting-pairing","content":"Troubleshooting pairing"},"541":{"id":"/docs/getting-started/pairing-devices-8","page_id":"/docs/getting-started/pairing-devices","type":"heading","tags":[],"url":"/docs/getting-started/pairing-devices#multiple-devices","content":"Multiple devices"},"542":{"id":"/docs/getting-started/pairing-devices-9","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices","content":"Gent lets you access your desktop sessions from any device on the same network. Your desktop is the server — it runs the terminals, AI agents, and editors. Paired devices are live mirrors that connect directly, with no cloud involved."},"543":{"id":"/docs/getting-started/pairing-devices-10","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#how-pairing-works","content":"Gent uses multicast UDP for automatic device discovery on your local network. When two devices running Gent are on the same Wi-Fi or LAN, they find each other automatically. No manual IP entry, no account creation, no cloud relay."},"544":{"id":"/docs/getting-started/pairing-devices-11","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#launch-gent-on-both-devices","content":"Open Gent on your desktop and on the device you want to pair (phone, tablet, or another computer)."},"545":{"id":"/docs/getting-started/pairing-devices-12","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#wait-for-discovery","content":"Devices on the same network appear automatically in the sidebar within a few seconds. You will see the other device's name show up under the device list."},"546":{"id":"/docs/getting-started/pairing-devices-13","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#tap-to-pair","content":"Select the discovered device in the sidebar. The first connection establishes the pairing. Once paired, the device remembers the connection for future sessions."},"547":{"id":"/docs/getting-started/pairing-devices-14","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#what-paired-devices-can-do","content":"Once paired, the remote device can:"},"548":{"id":"/docs/getting-started/pairing-devices-15","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#what-paired-devices-can-do","content":"View and interact with all terminal sessions running on the desktop"},"549":{"id":"/docs/getting-started/pairing-devices-16","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#what-paired-devices-can-do","content":"Chat with AI agents that are running on the desktop"},"550":{"id":"/docs/getting-started/pairing-devices-17","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#what-paired-devices-can-do","content":"Browse and edit files through the IDE"},"551":{"id":"/docs/getting-started/pairing-devices-18","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#what-paired-devices-can-do","content":"Preview web apps running on the desktop's localhost"},"552":{"id":"/docs/getting-started/pairing-devices-19","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#what-paired-devices-can-do","content":"Send and receive files"},"553":{"id":"/docs/getting-started/pairing-devices-20","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#what-paired-devices-can-do","content":"Mobile devices (iOS/Android) do not run sessions locally. All terminals, agent chats, and IDE sessions live on the desktop. The mobile app is a remote viewer and controller."},"554":{"id":"/docs/getting-started/pairing-devices-21","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#network-requirements","content":"Both devices must be on the **same local network** (same Wi-Fi or LAN)"},"555":{"id":"/docs/getting-started/pairing-devices-22","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#network-requirements","content":"Gent uses TCP port **53317** by default for communication (configurable in Settings)"},"556":{"id":"/docs/getting-started/pairing-devices-23","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#network-requirements","content":"Multicast UDP must not be blocked by your router — most home and office networks allow it"},"557":{"id":"/docs/getting-started/pairing-devices-24","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#network-requirements","content":"No internet connection is required for pairing"},"558":{"id":"/docs/getting-started/pairing-devices-25","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#troubleshooting-pairing","content":"If devices don't discover each other:"},"559":{"id":"/docs/getting-started/pairing-devices-26","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#troubleshooting-pairing","content":"Confirm both devices are on the same Wi-Fi network"},"560":{"id":"/docs/getting-started/pairing-devices-27","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#troubleshooting-pairing","content":"Check that no firewall is blocking port 53317 (TCP) or multicast (UDP)"},"561":{"id":"/docs/getting-started/pairing-devices-28","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#troubleshooting-pairing","content":"On macOS, ensure Gent has local network permission in **System Settings > Privacy & Security > Local Network**"},"562":{"id":"/docs/getting-started/pairing-devices-29","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#troubleshooting-pairing","content":"Try restarting Gent on both devices — this triggers a fresh multicast scan"},"563":{"id":"/docs/getting-started/pairing-devices-30","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#troubleshooting-pairing","content":"If automatic discovery fails, check Remote Troubleshooting for manual connection options"},"564":{"id":"/docs/getting-started/pairing-devices-31","page_id":"/docs/getting-started/pairing-devices","tags":[],"type":"text","url":"/docs/getting-started/pairing-devices#multiple-devices","content":"You can pair multiple devices with the same desktop. Each paired device appears in the sidebar, and switching between them shows that device's remote sessions. Your local device is always listed first."},"565":{"id":"/docs/reference/keyboard-shortcuts","page_id":"/docs/reference/keyboard-shortcuts","type":"page","content":"Keyboard Shortcuts","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/keyboard-shortcuts"},"566":{"id":"/docs/reference/keyboard-shortcuts-0","page_id":"/docs/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/reference/keyboard-shortcuts","content":"Common keyboard shortcuts for Gent on desktop."},"567":{"id":"/docs/reference/keyboard-shortcuts-1","page_id":"/docs/reference/keyboard-shortcuts","type":"heading","tags":[],"url":"/docs/reference/keyboard-shortcuts#general","content":"General"},"568":{"id":"/docs/reference/keyboard-shortcuts-2","page_id":"/docs/reference/keyboard-shortcuts