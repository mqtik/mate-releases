or example, a \"code review\" skill might add a `/review` command that instructs the agent to follow a specific review checklist. A \"testing\" skill might add `/test-spec` that generates tests from a specification file. Skills encode best practices into repeatable, shareable commands."},"1230":{"id":"/docs/integrations/skills-13","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"When you install a skill, Gent places it in the appropriate directory for each CLI:"},"1231":{"id":"/docs/integrations/skills-14","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"CLI"},"1232":{"id":"/docs/integrations/skills-15","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"Skill directory"},"1233":{"id":"/docs/integrations/skills-16","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"Claude Code"},"1234":{"id":"/docs/integrations/skills-17","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"`.claude/skills/`"},"1235":{"id":"/docs/integrations/skills-18","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"Codex"},"1236":{"id":"/docs/integrations/skills-19","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"`.codex/skills/`"},"1237":{"id":"/docs/integrations/skills-20","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"Copilot"},"1238":{"id":"/docs/integrations/skills-21","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"`.copilot/skills/`"},"1239":{"id":"/docs/integrations/skills-22","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"Shared"},"1240":{"id":"/docs/integrations/skills-23","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"`.mate/skills/`"},"1241":{"id":"/docs/integrations/skills-24","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"Skills installed through Gent are symlinked across CLI directories, so a single skill works with all your agents without duplication. Install it once, use it everywhere."},"1242":{"id":"/docs/integrations/skills-25","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#how-skills-work","content":"Each skill is a markdown file that contains the prompt template and metadata the CLI uses to register it as a slash command."},"1243":{"id":"/docs/integrations/skills-26","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#open-settings","content":"Go to the **Settings** tab in Gent."},"1244":{"id":"/docs/integrations/skills-27","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#navigate-to-skills","content":"Find the **Skills** section. This shows the marketplace — a browsable list of available skills organized by category."},"1245":{"id":"/docs/integrations/skills-28","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#browse-and-preview","content":"Each skill shows its name, description, and what slash commands it adds. You can preview the full prompt template before installing."},"1246":{"id":"/docs/integrations/skills-29","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#install","content":"Tap **Install** on any skill. Gent downloads it and symlinks it into the appropriate CLI directories. The skill is immediately available in your next agent chat session."},"1247":{"id":"/docs/integrations/skills-30","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#using-skills-in-chat","content":"Once installed, skills appear as slash commands in agent chat. Type `/` in the composer to see available commands. Select one to invoke the skill — the prompt template is sent to the agent, which follows its instructions."},"1248":{"id":"/docs/integrations/skills-31","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#using-skills-in-chat","content":"Some skills are fire-and-forget (run a single task), while others are interactive (the agent asks follow-up questions based on the skill's template)."},"1249":{"id":"/docs/integrations/skills-32","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#skill-structure","content":"A skill is a markdown file with frontmatter metadata:"},"1250":{"id":"/docs/integrations/skills-33","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#skill-structure","content":"The CLI reads the frontmatter to register the slash command, and uses the body as the prompt template when invoked."},"1251":{"id":"/docs/integrations/skills-34","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#managing-installed-skills","content":"In the Skills section of Settings, you can see all installed skills and:"},"1252":{"id":"/docs/integrations/skills-35","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#managing-installed-skills","content":"**Uninstall** a skill to remove it from all CLI directories"},"1253":{"id":"/docs/integrations/skills-36","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#managing-installed-skills","content":"**Update** a skill if a newer version is available in the marketplace"},"1254":{"id":"/docs/integrations/skills-37","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#managing-installed-skills","content":"**View details** to see the full prompt template"},"1255":{"id":"/docs/integrations/skills-38","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#custom-skills","content":"You can create your own skills by placing markdown files directly in `.mate/skills/` or the CLI-specific skill directories. Custom skills follow the same format as marketplace skills and appear alongside them in the slash command list."},"1256":{"id":"/docs/integrations/skills-39","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#custom-skills","content":"This is useful for team-specific workflows — write a skill once, share the file, and everyone on the team gets the same commands."},"1257":{"id":"/docs/remote/mobile","page_id":"/docs/remote/mobile","type":"page","content":"Mobile Usage","breadcrumbs":["Docs","Remote"],"tags":[],"url":"/docs/remote/mobile"},"1258":{"id":"/docs/remote/mobile-0","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile","content":"Using Gent from your iPhone or Android device."},"1259":{"id":"/docs/remote/mobile-1","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#getting-started-on-mobile","content":"Getting started on mobile"},"1260":{"id":"/docs/remote/mobile-2","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#install-gent","content":"Install Gent"},"1261":{"id":"/docs/remote/mobile-3","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#connect-to-your-desktop","content":"Connect to your desktop"},"1262":{"id":"/docs/remote/mobile-4","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#select-your-desktop","content":"Select your desktop"},"1263":{"id":"/docs/remote/mobile-5","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#what-you-can-do","content":"What you can do"},"1264":{"id":"/docs/remote/mobile-6","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#terminals","content":"Terminals"},"1265":{"id":"/docs/remote/mobile-7","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#agent-chat","content":"Agent chat"},"1266":{"id":"/docs/remote/mobile-8","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#ide-and-editor","content":"IDE and editor"},"1267":{"id":"/docs/remote/mobile-9","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#web-preview","content":"Web preview"},"1268":{"id":"/docs/remote/mobile-10","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#file-transfer","content":"File transfer"},"1269":{"id":"/docs/remote/mobile-11","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#tips-for-mobile","content":"Tips for mobile"},"1270":{"id":"/docs/remote/mobile-12","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#creating-sessions-remotely","content":"Creating sessions remotely"},"1271":{"id":"/docs/remote/mobile-13","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#network-considerations","content":"Network considerations"},"1272":{"id":"/docs/remote/mobile-14","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile","content":"Gent on mobile gives you full access to your desktop's sessions from your phone or tablet. It is not a simplified version — you get the same terminals, agent chats, editors, and web previews, just optimized for a smaller screen."},"1273":{"id":"/docs/remote/mobile-15","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#install-gent","content":"Download Gent from the App Store (iOS) or Google Play (Android)."},"1274":{"id":"/docs/remote/mobile-16","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#connect-to-your-desktop","content":"Make sure your phone and desktop are on the same Wi-Fi network. Open Gent on both devices. Your desktop should appear in the sidebar automatically within a few seconds."},"1275":{"id":"/docs/remote/mobile-17","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#select-your-desktop","content":"Tap your desktop in the sidebar. The workspace switches to show your desktop's sessions."},"1276":{"id":"/docs/remote/mobile-18","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#terminals","content":"Full terminal access from your phone. The terminal renders with xterm emulation, supports scrollback, and handles interactive programs. The on-screen keyboard works for typing commands, and you can scroll through output history."},"1277":{"id":"/docs/remote/mobile-19","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#agent-chat","content":"Interact with AI agent sessions running on your desktop. Send messages, view streaming responses, and see tool use in real time. This is great for monitoring long-running agent tasks while away from your desk."},"1278":{"id":"/docs/remote/mobile-20","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#ide-and-editor","content":"Browse your project's file tree and edit files. Changes save directly to the desktop's filesystem. The editor supports syntax highlighting and standard text editing gestures."},"1279":{"id":"/docs/remote/mobile-21","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#web-preview","content":"View web apps running on your desktop's localhost. This is genuinely useful for mobile testing — see your responsive design on an actual phone screen, running from your actual dev server."},"1280":{"id":"/docs/remote/mobile-22","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#file-transfer","content":"Send files from your phone to your desktop, or receive files from the desktop. Useful for sharing screenshots, photos, or documents without going through a cloud service."},"1281":{"id":"/docs/remote/mobile-23","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"**Landscape mode** gives you more horizontal space for terminals and code editing"},"1282":{"id":"/docs/remote/mobile-24","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"**Swipe** to switch between tabs"},"1283":{"id":"/docs/remote/mobile-25","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"**Long press** for context menus on tabs and sessions"},"1284":{"id":"/docs/remote/mobile-26","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"**Create sessions** from your phone — they are created on the desktop but you can interact with them immediately"},"1285":{"id":"/docs/remote/mobile-27","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"Your phone does not run terminals, AI agents, or the IDE locally. All processing happens on the desktop. Your phone sends input and displays output over the network connection."},"1286":{"id":"/docs/remote/mobile-28","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#creating-sessions-remotely","content":"You can create new terminals, agent chats, and other sessions from your phone. When you do, the session is created on the paired desktop — your phone just tells the desktop to start it. This means:"},"1287":{"id":"/docs/remote/mobile-29","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#creating-sessions-remotely","content":"New terminals use the desktop's shell and filesystem"},"1288":{"id":"/docs/remote/mobile-30","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#creating-sessions-remotely","content":"New agent chats use the desktop's CLI installations and MCP connectors"},"1289":{"id":"/docs/remote/mobile-31","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#creating-sessions-remotely","content":"New IDE tabs browse the desktop's files"},"1290":{"id":"/docs/remote/mobile-32","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#network-considerations","content":"Mobile works best on a stable Wi-Fi connection. The app handles temporary disconnections gracefully — if you walk out of range briefly and come back, it reconnects. For persistent connectivity issues, see Troubleshooting."},"1291":{"id":"/docs/remote/overview","page_id":"/docs/remote/overview","type":"page","content":"Remote Sessions","breadcrumbs":["Docs","Remote"],"tags":[],"url":"/docs/remote/overview"},"1292":{"id":"/docs/remote/overview-0","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview","content":"How remote access works in Gent — your desktop is the server, other devices are mirrors."},"1293":{"id":"/docs/remote/overview-1","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#the-mental-model","content":"The mental model"},"1294":{"id":"/docs/remote/overview-2","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#what-remote-devices-can-do","content":"What remote devices can do"},"1295":{"id":"/docs/remote/overview-3","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#how-it-connects","content":"How it connects"},"1296":{"id":"/docs/remote/overview-4","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#device-switching","content":"Device switching"},"1297":{"id":"/docs/remote/overview-5","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#security","content":"Security"},"1298":{"id":"/docs/remote/overview-6","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#platform-capabilities","content":"Platform capabilities"},"1299":{"id":"/docs/remote/overview-7","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview","content":"Gent's remote feature lets you access your desktop's sessions from any paired device on the same network. Understanding the architecture helps you get the most out of it."},"1300":{"id":"/docs/remote/overview-8","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Your **desktop** (Mac, Windows, or Linux) is the source of truth. It runs the server and owns all session state:"},"1301":{"id":"/docs/remote/overview-9","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Terminal processes (PTY shells)"},"1302":{"id":"/docs/remote/overview-10","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Agent chat sessions (CLI subprocesses)"},"1303":{"id":"/docs/remote/overview-11","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"IDE and editor state"},"1304":{"id":"/docs/remote/overview-12","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Web preview proxies"},"1305":{"id":"/docs/remote/overview-13","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"File storage"},"1306":{"id":"/docs/remote/overview-14","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"MCP connector processes"},"1307":{"id":"/docs/remote/overview-15","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"A **remote device** (phone, tablet, or another computer) is a paired mirror client. It does not run its own sessions. Instead, it connects to the desktop over the local network and presents a live view of the desktop's sessions."},"1308":{"id":"/docs/remote/overview-16","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Remote sessions are not copies. They are live mirrors. When you type in a terminal on your phone, the keystrokes go to the desktop's shell process, and the output streams back to your phone in real time."},"1309":{"id":"/docs/remote/overview-17","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"From a remote device, you can:"},"1310":{"id":"/docs/remote/overview-18","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**View and interact** with all terminal sessions on the desktop"},"1311":{"id":"/docs/remote/overview-19","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Chat with AI agents** running on the desktop"},"1312":{"id":"/docs/remote/overview-20","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Browse and edit files** through the IDE"},"1313":{"id":"/docs/remote/overview-21","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Preview web apps** running on the desktop's localhost"},"1314":{"id":"/docs/remote/overview-22","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Create new sessions** — these are created on the desktop, not on the remote device"},"1315":{"id":"/docs/remote/overview-23","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Send and receive files** between devices"},"1316":{"id":"/docs/remote/overview-24","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"Gent uses direct TCP connections over your local network. The default port is **53317**. Device discovery happens automatically via multicast UDP — no manual IP configuration needed."},"1317":{"id":"/docs/remote/overview-25","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"The connection flow:"},"1318":{"id":"/docs/remote/overview-26","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"Both devices run Gent on the same network"},"1319":{"id":"/docs/remote/overview-27","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"Multicast discovery finds nearby devices automatically"},"1320":{"id":"/docs/remote/overview-28","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"Selecting a device in the sidebar establishes a TCP connection"},"1321":{"id":"/docs/remote/overview-29","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"All session data flows directly between devices — no cloud relay"},"1322":{"id":"/docs/remote/overview-30","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#device-switching","content":"The sidebar lists your local device and all paired remote devices. Tapping a device switches the workspace to show that device's sessions:"},"1323":{"id":"/docs/remote/overview-31","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#device-switching","content":"**Local device selected**: workspace shows your local terminals, chats, editors"},"1324":{"id":"/docs/remote/overview-32","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#device-switching","content":"**Remote device selected**: workspace shows that remote device's sessions"},"1325":{"id":"/docs/remote/overview-33","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#device-switching","content":"Every UI component — tabs, projects, terminal lists — filters based on which device is currently selected."},"1326":{"id":"/docs/remote/overview-34","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#security","content":"All communication happens on your local network. No data leaves your network, no accounts are required, and no cloud services are involved. Device pairing is based on trust within your local network."},"1327":{"id":"/docs/remote/overview-35","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Capability"},"1328":{"id":"/docs/remote/overview-36","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Desktop"},"1329":{"id":"/docs/remote/overview-37","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Mobile"},"1330":{"id":"/docs/remote/overview-38","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Run terminal sessions"},"1331":{"id":"/docs/remote/overview-39","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (local)"},"1332":{"id":"/docs/remote/overview-40","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"No (remote mirror only)"},"1333":{"id":"/docs/remote/overview-41","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Run AI agent CLIs"},"1334":{"id":"/docs/remote/overview-42","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (local)"},"1335":{"id":"/docs/remote/overview-43","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"No (remote mirror only)"},"1336":{"id":"/docs/remote/overview-44","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Edit files"},"1337":{"id":"/docs/remote/overview-45","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (local)"},"1338":{"id":"/docs/remote/overview-46","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (remote, edits saved to desktop)"},"1339":{"id":"/docs/remote/overview-47","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Web preview"},"1340":{"id":"/docs/remote/overview-48","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (local + remote)"},"1341":{"id":"/docs/remote/overview-49","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (remote)"},"1342":{"id":"/docs/remote/overview-50","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"File transfer"},"1343":{"id":"/docs/remote/overview-51","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (send + receive)"},"1344":{"id":"/docs/remote/overview-52","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (send + receive)"},"1345":{"id":"/docs/remote/overview-53","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Create sessions"},"1346":{"id":"/docs/remote/overview-54","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (local)"},"1347":{"id":"/docs/remote/overview-55","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (created on paired desktop)"},"1348":{"id":"/docs/remote/troubleshooting","page_id":"/docs/remote/troubleshooting","type":"page","content":"Remote Troubleshooting","breadcrumbs":["Docs","Remote"],"tags":[],"url":"/docs/remote/troubleshooting"},"1349":{"id":"/docs/remote/troubleshooting-0","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting","content":"Common remote connection issues and how to fix them."},"1350":{"id":"/docs/remote/troubleshooting-1","page_id":"/docs/remote/troubleshooting","type":"heading","tags":[],"url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"Devices not discovering each other"},"1351":{"id":"/docs/remote/troubleshooting-2","page_id":"/docs/remote/troubleshooting","type":"heading","tags":[],"url":"/docs/remote/troubleshooting#connection-drops","content":"Connection drops"},"1352":{"id":"/docs/remote/troubleshooting-3","page_id":"/docs/remote/troubleshooting","type":"heading","tags":[],"url":"/docs/remote/troubleshooting#terminal-lag","content":"Terminal lag"},"1353":{"id":"/docs/remote/troubleshooting-4","page_id":"/docs/remote/troubleshooting","type":"heading","tags":[],"url":"/docs/remote/troubleshooting#port-conflicts","content":"Port conflicts"},"1354":{"id":"/docs/remote/troubleshooting-5","page_id":"/docs/remote/troubleshooting","type":"heading","tags":[],"url":"/docs/remote/troubleshooting#web-preview-not-loading","content":"Web preview not loading"},"1355":{"id":"/docs/remote/troubleshooting-6","page_id":"/docs/remote/troubleshooting","type":"heading","tags":[],"url":"/docs/remote/troubleshooting#agent-chat-not-connecting-remotely","content":"Agent chat not connecting remotely"},"1356":{"id":"/docs/remote/troubleshooting-7","page_id":"/docs/remote/troubleshooting","type":"heading","tags":[],"url":"/docs/remote/troubleshooting#still-stuck","content":"Still stuck?"},"1357":{"id":"/docs/remote/troubleshooting-8","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting","content":"Most remote connection problems come down to network configuration. Here are the common issues and their fixes."},"1358":{"id":"/docs/remote/troubleshooting-9","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"**Symptom**: You open Gent on both devices, but they do not appear in each other's sidebar."},"1359":{"id":"/docs/remote/troubleshooting-10","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"**Fixes**:"},"1360":{"id":"/docs/remote/troubleshooting-11","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"**Same network**: Confirm both devices are on the exact same Wi-Fi network. Some routers have separate 2.4GHz and 5GHz networks — make sure both devices are on the same one."},"1361":{"id":"/docs/remote/troubleshooting-12","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"**Multicast blocking**: Gent uses multicast UDP for discovery. Some enterprise networks, guest networks, and mesh routers block multicast traffic. Try a different network or check your router's settings."},"1362":{"id":"/docs/remote/troubleshooting-13","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"**macOS local network permission**: On macOS, go to **System Settings > Privacy & Security > Local Network** and make sure Gent is allowed."},"1363":{"id":"/docs/remote/troubleshooting-14","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"**Firewall**: Check that no firewall is blocking:"},"1364":{"id":"/docs/remote/troubleshooting-15","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"TCP port **53317** (or your configured port)"},"1365":{"id":"/docs/remote/troubleshooting-16","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"Multicast UDP traffic"},"1366":{"id":"/docs/remote/troubleshooting-17","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#devices-not-discovering-each-other","content":"**Restart both apps**: Close and reopen Gent on both devices. This triggers a fresh multicast scan."},"1367":{"id":"/docs/remote/troubleshooting-18","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#connection-drops","content":"**Symptom**: Devices pair successfully but the connection drops intermittently."},"1368":{"id":"/docs/remote/troubleshooting-19","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#connection-drops","content":"**Fixes**:"},"1369":{"id":"/docs/remote/troubleshooting-20","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#connection-drops","content":"**Wi-Fi stability**: Check signal strength on both devices. Weak Wi-Fi causes intermittent TCP disconnections."},"1370":{"id":"/docs/remote/troubleshooting-21","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#connection-drops","content":"**Sleep/standby**: When a device sleeps, the network connection drops. Gent reconnects automatically when the device wakes, but there may be a brief delay."},"1371":{"id":"/docs/remote/troubleshooting-22","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#connection-drops","content":"**Network switching**: If your phone switches between Wi-Fi and cellular, the connection drops. Make sure your phone stays on Wi-Fi."},"1372":{"id":"/docs/remote/troubleshooting-23","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#connection-drops","content":"Gent uses exponential backoff for reconnection attempts. If the connection drops, it will try to reconnect automatically — starting at 10 seconds and backing off to 80 seconds between attempts."},"1373":{"id":"/docs/remote/troubleshooting-24","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#terminal-lag","content":"**Symptom**: Typing in a remote terminal feels slow or laggy."},"1374":{"id":"/docs/remote/troubleshooting-25","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#terminal-lag","content":"**Fixes**:"},"1375":{"id":"/docs/remote/troubleshooting-26","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#terminal-lag","content":"**Network latency**: Remote terminals depend on network round-trip time. On a typical home Wi-Fi network, latency should be under 10ms. If it feels slow, check your network quality."},"1376":{"id":"/docs/remote/troubleshooting-27","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#terminal-lag","content":"**High output programs**: Programs that produce large amounts of output (e.g., `cat` on a huge file, `find /` without filters) can cause temporary lag as the data streams over the network."},"1377":{"id":"/docs/remote/troubleshooting-28","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#terminal-lag","content":"**Try restarting the session**: Close the terminal tab and open a new one. Occasionally a session can get into a degraded state."},"1378":{"id":"/docs/remote/troubleshooting-29","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#port-conflicts","content":"**Symptom**: Gent fails to start or pair, with errors about port 53317."},"1379":{"id":"/docs/remote/troubleshooting-30","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#port-conflicts","content":"**Fix**: Another application is using port 53317. You can change Gent's port in **Settings**. Make sure both devices use the same port."},"1380":{"id":"/docs/remote/troubleshooting-31","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#web-preview-not-loading","content":"**Symptom**: Web preview tab shows a blank page or connection error."},"1381":{"id":"/docs/remote/troubleshooting-32","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#web-preview-not-loading","content":"**Fixes**:"},"1382":{"id":"/docs/remote/troubleshooting-33","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#web-preview-not-loading","content":"**Server running**: Make sure your dev server is actually running on the specified port on the desktop"},"1383":{"id":"/docs/remote/troubleshooting-34","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#web-preview-not-loading","content":"**Localhost binding**: Some dev servers bind to `127.0.0.1` only. Gent's reverse proxy handles this, but check that the server is running"},"1384":{"id":"/docs/remote/troubleshooting-35","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#web-preview-not-loading","content":"**Port number**: Double-check you entered the correct port number in the web preview tab"},"1385":{"id":"/docs/remote/troubleshooting-36","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#agent-chat-not-connecting-remotely","content":"**Symptom**: You can see agent chat tabs from a remote device but cannot send messages or see updates."},"1386":{"id":"/docs/remote/troubleshooting-37","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#agent-chat-not-connecting-remotely","content":"**Fixes**:"},"1387":{"id":"/docs/remote/troubleshooting-38","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#agent-chat-not-connecting-remotely","content":"**CLI installed on desktop**: The AI CLI (Claude Code, Codex, etc.) must be installed on the desktop, not the remote device"},"1388":{"id":"/docs/remote/troubleshooting-39","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#agent-chat-not-connecting-remotely","content":"**Process running**: Check that the agent chat process is still running on the desktop — it may have exited due to an error"},"1389":{"id":"/docs/remote/troubleshooting-40","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#agent-chat-not-connecting-remotely","content":"**Reconnect**: Switch away from the remote device in the sidebar and switch back to force a reconnection"},"1390":{"id":"/docs/remote/troubleshooting-41","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#still-stuck","content":"If none of the above fixes your issue:"},"1391":{"id":"/docs/remote/troubleshooting-42","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#still-stuck","content":"Check the app logs for error messages"},"1392":{"id":"/docs/remote/troubleshooting-43","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#still-stuck","content":"Try pairing on a different network (e.g., a phone hotspot) to isolate whether the issue is network-specific"},"1393":{"id":"/docs/remote/troubleshooting-44","page_id":"/docs/remote/troubleshooting","tags":[],"type":"text","url":"/docs/remote/troubleshooting#still-stuck","content":"Verify that both devices are running the same version of Gent"}},"count":1393},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":1312,"2":197,"3":959,"4":1315,"5":671,"6":622,"7":1209,"8":463,"9":886,"10":317,"11":981,"12":370,"13":1256,"14":94,"15":12,"16":87,"17":33,"18":34,"19":76,"20":123,"21":117,"22":73,"23":22,"24":127,"25":54,"26":114,"27":1387,"28":213,"29":316,"30":1112,"31":274,"32":1102,"33":1239,"34":1235,"35":270,"36":493,"37":398,"38":573,"39":996,"40":790,"41":304,"42":475,"43":542,"44":1081,"45":795,"46":972,"47":1222,"48":219,"49":336,