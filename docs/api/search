ntegrations/connector-setup-3","page_id":"/docs/integrations/connector-setup","type":"heading","tags":[],"url":"/docs/integrations/connector-setup#browse-connectors","content":"Browse connectors"},"457":{"id":"/docs/integrations/connector-setup-4","page_id":"/docs/integrations/connector-setup","type":"heading","tags":[],"url":"/docs/integrations/connector-setup#select-a-connector","content":"Select a connector"},"458":{"id":"/docs/integrations/connector-setup-5","page_id":"/docs/integrations/connector-setup","type":"heading","tags":[],"url":"/docs/integrations/connector-setup#enter-credentials","content":"Enter credentials"},"459":{"id":"/docs/integrations/connector-setup-6","page_id":"/docs/integrations/connector-setup","type":"heading","tags":[],"url":"/docs/integrations/connector-setup#enable-the-connector","content":"Enable the connector"},"460":{"id":"/docs/integrations/connector-setup-7","page_id":"/docs/integrations/connector-setup","type":"heading","tags":[],"url":"/docs/integrations/connector-setup#verifying-a-connector","content":"Verifying a connector"},"461":{"id":"/docs/integrations/connector-setup-8","page_id":"/docs/integrations/connector-setup","type":"heading","tags":[],"url":"/docs/integrations/connector-setup#command-resolution","content":"Command resolution"},"462":{"id":"/docs/integrations/connector-setup-9","page_id":"/docs/integrations/connector-setup","type":"heading","tags":[],"url":"/docs/integrations/connector-setup#credential-storage","content":"Credential storage"},"463":{"id":"/docs/integrations/connector-setup-10","page_id":"/docs/integrations/connector-setup","type":"heading","tags":[],"url":"/docs/integrations/connector-setup#disabling-a-connector","content":"Disabling a connector"},"464":{"id":"/docs/integrations/connector-setup-11","page_id":"/docs/integrations/connector-setup","type":"heading","tags":[],"url":"/docs/integrations/connector-setup#troubleshooting","content":"Troubleshooting"},"465":{"id":"/docs/integrations/connector-setup-12","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup","content":"Setting up a connector takes about a minute. Here is the process from start to finish."},"466":{"id":"/docs/integrations/connector-setup-13","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#open-settings","content":"Go to the Settings tab in Gent and find the **Connectors** section."},"467":{"id":"/docs/integrations/connector-setup-14","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#browse-connectors","content":"You will see the full list of available connectors organized by category. Each connector shows its name, description, and what credentials it needs."},"468":{"id":"/docs/integrations/connector-setup-15","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#select-a-connector","content":"Click on the connector you want to enable. For example, **GitHub**."},"469":{"id":"/docs/integrations/connector-setup-16","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#enter-credentials","content":"Most connectors require an API key or token. The setup form shows:"},"470":{"id":"/docs/integrations/connector-setup-17","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#enter-credentials","content":"What credential is needed (e.g., \"Personal Access Token\")"},"471":{"id":"/docs/integrations/connector-setup-18","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#enter-credentials","content":"A link to where you can create one (e.g., GitHub's token settings page)"},"472":{"id":"/docs/integrations/connector-setup-19","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#enter-credentials","content":"Guidance on what permissions/scopes to grant"},"473":{"id":"/docs/integrations/connector-setup-20","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#enter-credentials","content":"Enter your credentials and save. They are stored locally in encrypted storage on your device."},"474":{"id":"/docs/integrations/connector-setup-21","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#enable-the-connector","content":"Toggle the connector on. Gent verifies that the required command (usually `npx`) is available and that the connector can start."},"475":{"id":"/docs/integrations/connector-setup-22","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#verifying-a-connector","content":"After enabling a connector, you can verify it works by:"},"476":{"id":"/docs/integrations/connector-setup-23","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#verifying-a-connector","content":"Opening a new **Agent Chat** tab"},"477":{"id":"/docs/integrations/connector-setup-24","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#verifying-a-connector","content":"Asking the agent to use a tool from that connector"},"478":{"id":"/docs/integrations/connector-setup-25","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#verifying-a-connector","content":"For example, with the GitHub connector enabled, ask: \"List my open pull requests.\" If the agent successfully calls the GitHub tools, the connector is working."},"479":{"id":"/docs/integrations/connector-setup-26","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#command-resolution","content":"Connectors typically run via `npx` (Node.js package runner). Gent resolves commands in this order:"},"480":{"id":"/docs/integrations/connector-setup-27","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#command-resolution","content":"**Bundled runtime** — Gent includes its own Node.js, so `npx` works without a system Node.js installation"},"481":{"id":"/docs/integrations/connector-setup-28","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#command-resolution","content":"**System PATH** — falls back to your system's Node.js if the bundled one is unavailable"},"482":{"id":"/docs/integrations/connector-setup-29","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#command-resolution","content":"You do not need Node.js installed on your system. Gent bundles a complete Node.js runtime on macOS, Windows, and Linux."},"483":{"id":"/docs/integrations/connector-setup-30","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#credential-storage","content":"Credentials are stored locally on your device using platform-native secure storage. They are never sent to any server — only passed as environment variables to the connector process running on your machine."},"484":{"id":"/docs/integrations/connector-setup-31","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#credential-storage","content":"To update or remove credentials, go back to the connector's settings page."},"485":{"id":"/docs/integrations/connector-setup-32","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#disabling-a-connector","content":"Toggle the connector off in Settings. The connector process stops, and the agent can no longer use its tools. Your credentials remain saved so you can re-enable it without re-entering them."},"486":{"id":"/docs/integrations/connector-setup-33","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#troubleshooting","content":"**Connector fails to start**: Check that no firewall or security tool is blocking the `npx` process"},"487":{"id":"/docs/integrations/connector-setup-34","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#troubleshooting","content":"**Tools not appearing in chat**: Restart the agent chat session after enabling a new connector"},"488":{"id":"/docs/integrations/connector-setup-35","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#troubleshooting","content":"**Authentication errors**: Verify your API key/token is correct and has the required permissions"},"489":{"id":"/docs/integrations/connector-setup-36","page_id":"/docs/integrations/connector-setup","tags":[],"type":"text","url":"/docs/integrations/connector-setup#troubleshooting","content":"**Timeout errors**: Some connectors take a few seconds to initialize on first run as `npx` downloads the package"},"490":{"id":"/docs/integrations/custom-adapters","page_id":"/docs/integrations/custom-adapters","type":"page","content":"Custom Adapters","breadcrumbs":["Docs","Integrations"],"tags":[],"url":"/docs/integrations/custom-adapters"},"491":{"id":"/docs/integrations/custom-adapters-0","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters","content":"Add support for a new AI coding CLI by writing a declarative adapter — no app build required."},"492":{"id":"/docs/integrations/custom-adapters-1","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#how-it-works","content":"How it works"},"493":{"id":"/docs/integrations/custom-adapters-2","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#pick-a-tier","content":"Pick a tier"},"494":{"id":"/docs/integrations/custom-adapters-3","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#write-a-declarative-adapter","content":"Write a declarative adapter"},"495":{"id":"/docs/integrations/custom-adapters-4","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#create-the-spec","content":"Create the spec"},"496":{"id":"/docs/integrations/custom-adapters-5","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#install-it-with-add-adapter","content":"Install it with Add Adapter"},"497":{"id":"/docs/integrations/custom-adapters-6","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#test-it","content":"Test it"},"498":{"id":"/docs/integrations/custom-adapters-7","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"Models, effort, and slash commands"},"499":{"id":"/docs/integrations/custom-adapters-8","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"Turning output into chat"},"500":{"id":"/docs/integrations/custom-adapters-9","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#publish-to-the-registry","content":"Publish to the registry"},"501":{"id":"/docs/integrations/custom-adapters-10","page_id":"/docs/integrations/custom-adapters","type":"heading","tags":[],"url":"/docs/integrations/custom-adapters#tips","content":"Tips"},"502":{"id":"/docs/integrations/custom-adapters-11","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters","content":"Gent talks to AI coding CLIs (Claude Code, Codex, Copilot, …) through **adapters**. An\nadapter describes how to launch a CLI, what to show in its model / effort / slash-command\npickers, how to label its tools, and how to turn its output into Gent's chat. Most of an\nadapter is **data, not code** — so you can add a new CLI by writing a JSON file."},"503":{"id":"/docs/integrations/custom-adapters-12","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters","content":"Custom adapters are part of Gent's runtime-extensible adapter system. This page documents\nthe authoring format; availability ships with the rollout of the new adapter engine."},"504":{"id":"/docs/integrations/custom-adapters-13","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#how-it-works","content":"Two things are always true:"},"505":{"id":"/docs/integrations/custom-adapters-14","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#how-it-works","content":"**The desktop host runs the adapter.** A paired phone is a viewer — it never spawns a\nCLI; it just mirrors what the host produces. Get it working on your Mac/PC and it works\non your phone automatically."},"506":{"id":"/docs/integrations/custom-adapters-15","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#how-it-works","content":"**Pure-data adapters can't execute anything.** When a CLI genuinely needs parsing code,\nthat code runs in a sandbox (WASM) or as a signed first-party driver — never as\nunsandboxed downloaded code."},"507":{"id":"/docs/integrations/custom-adapters-16","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#pick-a-tier","content":"How you build the adapter depends on how the CLI talks."},"508":{"id":"/docs/integrations/custom-adapters-17","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#pick-a-tier","content":"<Card title=\"Declarative (most CLIs)\" description=\"The CLI prints a simple format (e.g. one JSON object per line). You write only a JSON spec. No app build.\" />"},"509":{"id":"/docs/integrations/custom-adapters-18","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#pick-a-tier","content":"<Card title=\"Sandboxed WASM\" description=\"The CLI needs real parsing code. You ship a JSON spec plus a .wasm module that runs in a sandbox on the host. No app build.\" />"},"510":{"id":"/docs/integrations/custom-adapters-19","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#pick-a-tier","content":"<Card title=\"Bundled driver\" description=\"Rare: a protocol needing full host trust. Requires a first-party code change shipped in an app release.\" />"},"511":{"id":"/docs/integrations/custom-adapters-20","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#create-the-spec","content":"A complete, working adapter for a CLI that emits one JSON object per line:"},"512":{"id":"/docs/integrations/custom-adapters-21","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#install-it-with-add-adapter","content":"Open **Add Adapter** in Gent, paste your adapter JSON (or a GitHub repo URL). Gent\nvalidates it and — if it spawns a command — shows you the exact command before anything\nruns. Approve to install."},"513":{"id":"/docs/integrations/custom-adapters-22","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#test-it","content":"Start a new agent chat with your adapter selected and send a prompt. Your model picker,\ntools, and messages should appear just like a built-in CLI."},"514":{"id":"/docs/integrations/custom-adapters-23","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"These are **catalogs** — lists that drive the pickers. The picker shows the `label`; the\n`id` is what gets sent to the CLI. Omit a catalog and its picker disappears."},"515":{"id":"/docs/integrations/custom-adapters-24","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"When the user picks a model or effort, its `id` becomes the variable `{model}` / `{effort}`.\nYou choose where it goes — and that depends on the CLI:"},"516":{"id":"/docs/integrations/custom-adapters-25","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"Most CLIs take model/effort as command-line arguments. Reference the variable in\n`spawn.args`. Changing the selection respawns the process."},"517":{"id":"/docs/integrations/custom-adapters-26","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"`validValues` rejects an unknown effort; `when` skips the flag when nothing is selected."},"518":{"id":"/docs/integrations/custom-adapters-27","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"CLIs like Codex/Copilot accept model/effort with each turn, so they can change\nmid-session without restarting. Set `perTurnSettings` and put the variables in the\nmessage template instead of the spawn args."},"519":{"id":"/docs/integrations/custom-adapters-28","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#models-effort-and-slash-commands","content":"The `models` list is a fallback. If your CLI can report its real models at runtime, the\ndriver uses those and overrides the list."},"520":{"id":"/docs/integrations/custom-adapters-29","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"The `parsing` rules run against each line of the CLI's output; the first match wins. The\nvocabulary is small on purpose — `match`, `extract`, `emit`, a shallow `setFlag`, and\n`escalate`:"},"521":{"id":"/docs/integrations/custom-adapters-30","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"`match` — pick lines by JSON path, value, regex, or field presence."},"522":{"id":"/docs/integrations/custom-adapters-31","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"`extract` — pull named fields (with ordered fallbacks)."},"523":{"id":"/docs/integrations/custom-adapters-32","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"`emit` — produce a Gent event (`assistantDelta`, `toolStart`, `toolDone`, `turnComplete`, …)."},"524":{"id":"/docs/integrations/custom-adapters-33","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"`escalate` — for anything stateful, hand off to a WASM or bundled driver instead of\ngrowing the rules."},"525":{"id":"/docs/integrations/custom-adapters-34","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#turning-output-into-chat","content":"If your CLI needs real, cross-line parsing logic, that's the cue for a **sandboxed WASM\nadapter** (`driver.type: \"wasm\"` with a hash-pinned module) rather than stretching the\ndeclarative rules."},"526":{"id":"/docs/integrations/custom-adapters-35","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#publish-to-the-registry","content":"To share an adapter with everyone, open a pull request to &#x2A;*`mqtik/mate-adapters`** adding\nyour `specs/<id>.json` (and the `.wasm` for a WASM adapter). Once merged and signed, every\nGent install picks it up on the next refresh — no app update. Fixes ship as a new immutable\nversion, so rollback is a one-line change."},"527":{"id":"/docs/integrations/custom-adapters-36","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"Namespace your `id`; the built-in `claude` / `codex` / `copilot` ids are protected."},"528":{"id":"/docs/integrations/custom-adapters-37","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"Put every tool the CLI emits into `tools.categories`, or it shows up uncategorized."},"529":{"id":"/docs/integrations/custom-adapters-38","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"Tool categories can tighten approval, never relax it — unknown tools always ask."},"530":{"id":"/docs/integrations/custom-adapters-39","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"A bad or missing adapter degrades to a clear \"needs update\" state; it can't break the app."},"531":{"id":"/docs/integrations/custom-adapters-40","page_id":"/docs/integrations/custom-adapters","tags":[],"type":"text","url":"/docs/integrations/custom-adapters#tips","content":"See also: Custom Connectors for adding MCP servers\n(a different extension point — tools for an agent, rather than a new CLI)."},"532":{"id":"/docs/integrations/custom-connectors","page_id":"/docs/integrations/custom-connectors","type":"page","content":"Custom Connectors","breadcrumbs":["Docs","Integrations"],"tags":[],"url":"/docs/integrations/custom-connectors"},"533":{"id":"/docs/integrations/custom-connectors-0","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors","content":"Add your own MCP servers as connectors in Gent."},"534":{"id":"/docs/integrations/custom-connectors-1","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#what-you-need","content":"What you need"},"535":{"id":"/docs/integrations/custom-connectors-2","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#adding-a-custom-connector","content":"Adding a custom connector"},"536":{"id":"/docs/integrations/custom-connectors-3","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#prepare-your-mcp-server","content":"Prepare your MCP server"},"537":{"id":"/docs/integrations/custom-connectors-4","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#configure-in-gent","content":"Configure in Gent"},"538":{"id":"/docs/integrations/custom-connectors-5","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#test-the-connector","content":"Test the connector"},"539":{"id":"/docs/integrations/custom-connectors-6","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#examples","content":"Examples"},"540":{"id":"/docs/integrations/custom-connectors-7","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#nodejs-mcp-server-via-npx","content":"Node.js MCP server via npx"},"541":{"id":"/docs/integrations/custom-connectors-8","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#local-nodejs-script","content":"Local Node.js script"},"542":{"id":"/docs/integrations/custom-connectors-9","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#python-mcp-server","content":"Python MCP server"},"543":{"id":"/docs/integrations/custom-connectors-10","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#building-your-own-mcp-server","content":"Building your own MCP server"},"544":{"id":"/docs/integrations/custom-connectors-11","page_id":"/docs/integrations/custom-connectors","type":"heading","tags":[],"url":"/docs/integrations/custom-connectors#sharing-connectors","content":"Sharing connectors"},"545":{"id":"/docs/integrations/custom-connectors-12","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors","content":"Beyond the built-in connectors, you can add any MCP-compatible server as a custom connector. If you have built your own MCP server or want to use one from the community that is not in Gent's registry, you can configure it manually."},"546":{"id":"/docs/integrations/custom-connectors-13","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"A custom connector requires:"},"547":{"id":"/docs/integrations/custom-connectors-14","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"An **MCP server** that speaks the Model Context Protocol over stdio (stdin/stdout)"},"548":{"id":"/docs/integrations/custom-connectors-15","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"A **command** to start it (e.g., `npx`, `node`, `python`, or a binary path)"},"549":{"id":"/docs/integrations/custom-connectors-16","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"Any **arguments** the command needs"},"550":{"id":"/docs/integrations/custom-connectors-17","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#what-you-need","content":"Any **environment variables** for configuration (API keys, etc.)"},"551":{"id":"/docs/integrations/custom-connectors-18","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#adding-a-custom-connector","content":"Custom connectors are configured as MCP servers that Gent passes to the agent CLI at startup."},"552":{"id":"/docs/integrations/custom-connectors-19","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#prepare-your-mcp-server","content":"Make sure your server runs correctly from the command line. Test it independently first:"},"553":{"id":"/docs/integrations/custom-connectors-20","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#configure-in-gent","content":"Add the connector configuration in Gent's settings. You will need to provide:"},"554":{"id":"/docs/integrations/custom-connectors-21","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#configure-in-gent","content":"**Name**: A display name for the connector"},"555":{"id":"/docs/integrations/custom-connectors-22","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#configure-in-gent","content":"**Command**: The command to run (e.g., `npx`, `node`, `python`)"},"556":{"id":"/docs/integrations/custom-connectors-23","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#configure-in-gent","content":"**Arguments**: Command arguments (e.g., `-y @your-org/mcp-server`)"},"557":{"id":"/docs/integrations/custom-connectors-24","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#configure-in-gent","content":"**Environment variables**: Any API keys or config values the server needs"},"558":{"id":"/docs/integrations/custom-connectors-25","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#test-the-connector","content":"Open a new agent chat and ask the agent to list available tools. Your custom connector's tools should appear in the list."},"559":{"id":"/docs/integrations/custom-connectors-26","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#nodejs-mcp-server-via-npx","content":"If your server is published to npm:"},"560":{"id":"/docs/integrations/custom-connectors-27","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#nodejs-mcp-server-via-npx","content":"**Command**: `npx`"},"561":{"id":"/docs/integrations/custom-connectors-28","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#nodejs-mcp-server-via-npx","content":"**Args**: `-y @your-org/your-mcp-server`"},"562":{"id":"/docs/integrations/custom-connectors-29","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#nodejs-mcp-server-via-npx","content":"**Env**: Any required variables like `API_KEY`"},"563":{"id":"/docs/integrations/custom-connectors-30","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#local-nodejs-script","content":"If your server is a local file:"},"564":{"id":"/docs/integrations/custom-connectors-31","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#local-nodejs-script","content":"**Command**: `node`"},"565":{"id":"/docs/integrations/custom-connectors-32","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#local-nodejs-script","content":"**Args**: `/path/to/your/server.js`"},"566":{"id":"/docs/integrations/custom-connectors-33","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#local-nodejs-script","content":"**Env**: Any required variables"},"567":{"id":"/docs/integrations/custom-connectors-34","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#python-mcp-server","content":"If your server is written in Python:"},"568":{"id":"/docs/integrations/custom-connectors-35","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#python-mcp-server","content":"**Command**: `python`"},"569":{"id":"/docs/integrations/custom-connectors-36","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#python-mcp-server","content":"**Args**: `-m your_mcp_server`"},"570":{"id":"/docs/integrations/custom-connectors-37","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#python-mcp-server","content":"**Env**: Any required variables"},"571":{"id":"/docs/integrations/custom-connectors-38","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#python-mcp-server","content":"Gent bundles Node.js, so `npx` and `node` commands work without a system Node.js installation. For Python-based servers, you need Python installed on your system."},"572":{"id":"/docs/integrations/custom-connectors-39","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#building-your-own-mcp-server","content":"If you want to build a custom MCP server, the protocol is straightforward:"},"573":{"id":"/docs/integrations/custom-connectors-40","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#building-your-own-mcp-server","content":"Read JSON-RPC messages from stdin"},"574":{"id":"/docs/integrations/custom-connectors-41","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#building-your-own-mcp-server","content":"Process tool calls and return results"},"575":{"id":"/docs/integrations/custom-connectors-42","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#building-your-own-mcp-server","content":"Write JSON-RPC responses to stdout"},"576":{"id":"/docs/integrations/custom-connectors-43","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#building-your-own-mcp-server","content":"The MCP specification has full details on the protocol, tool definitions, and message formats. There are SDKs available for TypeScript, Python, and other languages that handle the protocol boilerplate."},"577":{"id":"/docs/integrations/custom-connectors-44","page_id":"/docs/integrations/custom-connectors","tags":[],"type":"text","url":"/docs/integrations/custom-connectors#sharing-connectors","content":"If you build a connector that others might find useful, consider publishing it to npm (for Node.js) or PyPI (for Python). The MCP ecosystem is growing, and community servers are easy to distribute as packages."},"578":{"id":"/docs/integrations/mate-forge","page_id":"/docs/integrations/mate-forge","type":"page","content":"Gent Forge","breadcrumbs":["Docs","Integrations"],"tags":[],"url":"/docs/integrations/mate-forge"},"579":{"id":"/docs/integrations/mate-forge-0","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge","content":"Type /connect anything and let an agent generate a custom MCP server for a product, API, website, or workflow."},"580":{"id":"/docs/integrations/mate-forge-1","page_id":"/docs/integrations/mate-forge","type":"heading","tags":[],"url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"What Forge can generate"},"581":{"id":"/docs/integrations/mate-forge-2","page_id":"/docs/integrations/mate-forge","type":"heading","tags":[],"url":"/docs/integrations/mate-forge#starting-with-connect","content":"Starting with `/connect`"},"582":{"id":"/docs/integrations/mate-forge-3","page_id":"/docs/integrations/mate-forge","type":"heading","tags":[],"url":"/docs/integrations/mate-forge#give-the-agent-context","content":"Give the agent context"},"583":{"id":"/docs/integrations/mate-forge-4","page_id":"/docs/integrations/mate-forge","type":"heading","tags":[],"url":"/docs/integrations/mate-forge#what-register-accepts","content":"What `register` accepts"},"584":{"id":"/docs/integrations/mate-forge-5","page_id":"/docs/integrations/mate-forge","type":"heading","tags":[],"url":"/docs/integrations/mate-forge#credential-flow","content":"Credential flow"},"585":{"id":"/docs/integrations/mate-forge-6","page_id":"/docs/integrations/mate-forge","type":"heading","tags":[],"url":"/docs/integrations/mate-forge#good-generated-connectors-are-small","content":"Good generated connectors are small"},"586":{"id":"/docs/integrations/mate-forge-7","page_id":"/docs/integrations/mate-forge","type":"heading","tags":[],"url":"/docs/integrations/mate-forge#review-generated-code","content":"Review generated code"},"587":{"id":"/docs/integrations/mate-forge-8","page_id":"/docs/integrations/mate-forge","type":"heading","tags":[],"url":"/docs/integrations/mate-forge#related","content":"Related"},"588":{"id":"/docs/integrations/mate-forge-9","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge","content":"Gent Forge is `/connect anything` for agents. If Gent does not already ship the exact connector you need, ask for it. The agent can generate a local MCP server, register it with Gent, and make that new toolset available to future agent sessions."},"589":{"id":"/docs/integrations/mate-forge-10","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge","content":"The point is not \"fill out a connector form.\" The point is:"},"590":{"id":"/docs/integrations/mate-forge-11","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge","content":"or:"},"591":{"id":"/docs/integrations/mate-forge-12","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge","content":"or:"},"592":{"id":"/docs/integrations/mate-forge-13","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge","content":"Gent gives the agent the Forge guide, a local workspace under `~/.mate/mcps`, and a built-in `mate-forge.register` tool. The agent does the boring work: understand the target, design the MCP tools, implement the server, compile it, and register it."},"593":{"id":"/docs/integrations/mate-forge-14","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"Forge is for generating MCP servers, not only API wrappers. A generated connector can expose tools for many kinds of targets:"},"594":{"id":"/docs/integrations/mate-forge-15","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"Target"},"595":{"id":"/docs/integrations/mate-forge-16","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"Example tools"},"596":{"id":"/docs/integrations/mate-forge-17","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"SaaS products"},"597":{"id":"/docs/integrations/mate-forge-18","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"create project, read status, update customer, send message"},"598":{"id":"/docs/integrations/mate-forge-19","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"Public APIs"},"599":{"id":"/docs/integrations/mate-forge-20","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"search records, fetch details, submit requests"},"600":{"id":"/docs/integrations/mate-forge-21","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"Private/internal APIs"},"601":{"id":"/docs/integrations/mate-forge-22","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/integrations/mate-forge#what-forge-can-generate","content":"run admin action, query account state, trigger workflow"},"602":{"id":"/docs/integrations/mate-forge-23","page_id":"/docs/integrations/mate-forge","tags":[],"type":"text","url":"/docs/