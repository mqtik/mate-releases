tags":[],"url":"/docs/remote/mobile#agent-chat","content":"Agent chat"},"1171":{"id":"/docs/remote/mobile-8","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#ide-and-editor","content":"IDE and editor"},"1172":{"id":"/docs/remote/mobile-9","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#web-preview","content":"Web preview"},"1173":{"id":"/docs/remote/mobile-10","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#file-transfer","content":"File transfer"},"1174":{"id":"/docs/remote/mobile-11","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#tips-for-mobile","content":"Tips for mobile"},"1175":{"id":"/docs/remote/mobile-12","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#creating-sessions-remotely","content":"Creating sessions remotely"},"1176":{"id":"/docs/remote/mobile-13","page_id":"/docs/remote/mobile","type":"heading","tags":[],"url":"/docs/remote/mobile#network-considerations","content":"Network considerations"},"1177":{"id":"/docs/remote/mobile-14","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile","content":"Gent on mobile gives you full access to your desktop's sessions from your phone or tablet. It is not a simplified version — you get the same terminals, agent chats, editors, and web previews, just optimized for a smaller screen."},"1178":{"id":"/docs/remote/mobile-15","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#install-gent","content":"Download Gent from the App Store (iOS) or Google Play (Android)."},"1179":{"id":"/docs/remote/mobile-16","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#connect-to-your-desktop","content":"Make sure your phone and desktop are on the same Wi-Fi network. Open Gent on both devices. Your desktop should appear in the sidebar automatically within a few seconds."},"1180":{"id":"/docs/remote/mobile-17","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#select-your-desktop","content":"Tap your desktop in the sidebar. The workspace switches to show your desktop's sessions."},"1181":{"id":"/docs/remote/mobile-18","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#terminals","content":"Full terminal access from your phone. The terminal renders with xterm emulation, supports scrollback, and handles interactive programs. The on-screen keyboard works for typing commands, and you can scroll through output history."},"1182":{"id":"/docs/remote/mobile-19","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#agent-chat","content":"Interact with AI agent sessions running on your desktop. Send messages, view streaming responses, and see tool use in real time. This is great for monitoring long-running agent tasks while away from your desk."},"1183":{"id":"/docs/remote/mobile-20","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#ide-and-editor","content":"Browse your project's file tree and edit files. Changes save directly to the desktop's filesystem. The editor supports syntax highlighting and standard text editing gestures."},"1184":{"id":"/docs/remote/mobile-21","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#web-preview","content":"View web apps running on your desktop's localhost. This is genuinely useful for mobile testing — see your responsive design on an actual phone screen, running from your actual dev server."},"1185":{"id":"/docs/remote/mobile-22","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#file-transfer","content":"Send files from your phone to your desktop, or receive files from the desktop. Useful for sharing screenshots, photos, or documents without going through a cloud service."},"1186":{"id":"/docs/remote/mobile-23","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"**Landscape mode** gives you more horizontal space for terminals and code editing"},"1187":{"id":"/docs/remote/mobile-24","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"**Swipe** to switch between tabs"},"1188":{"id":"/docs/remote/mobile-25","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"**Long press** for context menus on tabs and sessions"},"1189":{"id":"/docs/remote/mobile-26","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"**Create sessions** from your phone — they are created on the desktop but you can interact with them immediately"},"1190":{"id":"/docs/remote/mobile-27","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#tips-for-mobile","content":"Your phone does not run terminals, AI agents, or the IDE locally. All processing happens on the desktop. Your phone sends input and displays output over the network connection."},"1191":{"id":"/docs/remote/mobile-28","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#creating-sessions-remotely","content":"You can create new terminals, agent chats, and other sessions from your phone. When you do, the session is created on the paired desktop — your phone just tells the desktop to start it. This means:"},"1192":{"id":"/docs/remote/mobile-29","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#creating-sessions-remotely","content":"New terminals use the desktop's shell and filesystem"},"1193":{"id":"/docs/remote/mobile-30","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#creating-sessions-remotely","content":"New agent chats use the desktop's CLI installations and MCP connectors"},"1194":{"id":"/docs/remote/mobile-31","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#creating-sessions-remotely","content":"New IDE tabs browse the desktop's files"},"1195":{"id":"/docs/remote/mobile-32","page_id":"/docs/remote/mobile","tags":[],"type":"text","url":"/docs/remote/mobile#network-considerations","content":"Mobile works best on a stable Wi-Fi connection. The app handles temporary disconnections gracefully — if you walk out of range briefly and come back, it reconnects. For persistent connectivity issues, see Troubleshooting."},"1196":{"id":"/docs/remote/overview","page_id":"/docs/remote/overview","type":"page","content":"Remote Sessions","breadcrumbs":["Docs","Remote"],"tags":[],"url":"/docs/remote/overview"},"1197":{"id":"/docs/remote/overview-0","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview","content":"How remote access works in Gent — your desktop is the server, other devices are mirrors."},"1198":{"id":"/docs/remote/overview-1","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#the-mental-model","content":"The mental model"},"1199":{"id":"/docs/remote/overview-2","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#what-remote-devices-can-do","content":"What remote devices can do"},"1200":{"id":"/docs/remote/overview-3","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#how-it-connects","content":"How it connects"},"1201":{"id":"/docs/remote/overview-4","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#device-switching","content":"Device switching"},"1202":{"id":"/docs/remote/overview-5","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#security","content":"Security"},"1203":{"id":"/docs/remote/overview-6","page_id":"/docs/remote/overview","type":"heading","tags":[],"url":"/docs/remote/overview#platform-capabilities","content":"Platform capabilities"},"1204":{"id":"/docs/remote/overview-7","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview","content":"Gent's remote feature lets you access your desktop's sessions from any paired device on the same network. Understanding the architecture helps you get the most out of it."},"1205":{"id":"/docs/remote/overview-8","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Your **desktop** (Mac, Windows, or Linux) is the source of truth. It runs the server and owns all session state:"},"1206":{"id":"/docs/remote/overview-9","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Terminal processes (PTY shells)"},"1207":{"id":"/docs/remote/overview-10","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Agent chat sessions (CLI subprocesses)"},"1208":{"id":"/docs/remote/overview-11","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"IDE and editor state"},"1209":{"id":"/docs/remote/overview-12","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Web preview proxies"},"1210":{"id":"/docs/remote/overview-13","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"File storage"},"1211":{"id":"/docs/remote/overview-14","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"MCP connector processes"},"1212":{"id":"/docs/remote/overview-15","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"A **remote device** (phone, tablet, or another computer) is a paired mirror client. It does not run its own sessions. Instead, it connects to the desktop over the local network and presents a live view of the desktop's sessions."},"1213":{"id":"/docs/remote/overview-16","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#the-mental-model","content":"Remote sessions are not copies. They are live mirrors. When you type in a terminal on your phone, the keystrokes go to the desktop's shell process, and the output streams back to your phone in real time."},"1214":{"id":"/docs/remote/overview-17","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"From a remote device, you can:"},"1215":{"id":"/docs/remote/overview-18","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**View and interact** with all terminal sessions on the desktop"},"1216":{"id":"/docs/remote/overview-19","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Chat with AI agents** running on the desktop"},"1217":{"id":"/docs/remote/overview-20","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Browse and edit files** through the IDE"},"1218":{"id":"/docs/remote/overview-21","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Preview web apps** running on the desktop's localhost"},"1219":{"id":"/docs/remote/overview-22","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Create new sessions** — these are created on the desktop, not on the remote device"},"1220":{"id":"/docs/remote/overview-23","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#what-remote-devices-can-do","content":"**Send and receive files** between devices"},"1221":{"id":"/docs/remote/overview-24","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"Gent uses direct TCP connections over your local network. The default port is **53317**. Device discovery happens automatically via multicast UDP — no manual IP configuration needed."},"1222":{"id":"/docs/remote/overview-25","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"The connection flow:"},"1223":{"id":"/docs/remote/overview-26","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"Both devices run Gent on the same network"},"1224":{"id":"/docs/remote/overview-27","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"Multicast discovery finds nearby devices automatically"},"1225":{"id":"/docs/remote/overview-28","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"Selecting a device in the sidebar establishes a TCP connection"},"1226":{"id":"/docs/remote/overview-29","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#how-it-connects","content":"All session data flows directly between devices — no cloud relay"},"1227":{"id":"/docs/remote/overview-30","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#device-switching","content":"The sidebar lists your local device and all paired remote devices. Tapping a device switches the workspace to show that device's sessions:"},"1228":{"id":"/docs/remote/overview-31","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#device-switching","content":"**Local device selected**: workspace shows your local terminals, chats, editors"},"1229":{"id":"/docs/remote/overview-32","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#device-switching","content":"**Remote device selected**: workspace shows that remote device's sessions"},"1230":{"id":"/docs/remote/overview-33","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#device-switching","content":"Every UI component — tabs, projects, terminal lists — filters based on which device is currently selected."},"1231":{"id":"/docs/remote/overview-34","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#security","content":"All communication happens on your local network. No data leaves your network, no accounts are required, and no cloud services are involved. Device pairing is based on trust within your local network."},"1232":{"id":"/docs/remote/overview-35","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Capability"},"1233":{"id":"/docs/remote/overview-36","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Desktop"},"1234":{"id":"/docs/remote/overview-37","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Mobile"},"1235":{"id":"/docs/remote/overview-38","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Run terminal sessions"},"1236":{"id":"/docs/remote/overview-39","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"Yes (local)"},"1237":{"id":"/docs/remote/overview-40","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","content":"No (remote mirror only)"},"1238":{"id":"/docs/remote/overview-41","page_id":"/docs/remote/overview","tags":[],"type":"text","url":"/docs/remote/overview#platform-capabilities","