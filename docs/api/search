":"/docs","tags":[],"type":"text","url":"/docs#what-can-you-do-with-gent","content":"**Edit code** in a built-in IDE with syntax highlighting for 100+ languages, a file tree, and git integration"},"19":{"id":"/docs-17","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-can-you-do-with-gent","content":"**Preview web apps** running on any paired device's localhost through a built-in reverse proxy"},"20":{"id":"/docs-18","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-can-you-do-with-gent","content":"**Transfer files** between devices with drag-and-drop simplicity"},"21":{"id":"/docs-19","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-can-you-do-with-gent","content":"**Talk instead of type** with built-in voice input supporting four STT engines including offline Whisper"},"22":{"id":"/docs-20","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-can-you-do-with-gent","content":"**Orchestrate agents** by running multiple AI sessions in parallel across your projects"},"23":{"id":"/docs-21","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-can-you-do-with-gent","content":"**Connect to anything** with Gent Forge — type `/connect` and let the agent generate a purpose-built MCP server for a product, API, site, or workflow"},"24":{"id":"/docs-22","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-can-you-do-with-gent","content":"**Use Agentic Mobile** through Argent so agents can navigate, inspect, debug, and profile iOS or Android applications"},"25":{"id":"/docs-23","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-can-you-do-with-gent","content":"**Install skills** from the marketplace to add slash commands and specialized workflows to your agents"},"26":{"id":"/docs-24","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-can-you-do-with-gent","content":"**Sync across devices** — pair your phone, tablet, or another computer and access everything from anywhere on your network"},"27":{"id":"/docs-25","page_id":"/docs","tags":[],"type":"text","url":"/docs#how-it-works","content":"Your desktop runs Gent as the server. It owns all session state: terminals, projects, agent chats, and files. Your phone (or any other device on the same network) pairs with it and acts as a live mirror — you see and interact with the same sessions, in real time, from anywhere on your local network. No cloud. No accounts. Just your devices talking directly to each other."},"28":{"id":"/docs/features/agent-chat","page_id":"/docs/features/agent-chat","type":"page","content":"Agent Chat","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/agent-chat"},"29":{"id":"/docs/features/agent-chat-0","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat","content":"Chat with AI coding agents like Claude Code, Codex, and Copilot inside Gent."},"30":{"id":"/docs/features/agent-chat-1","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#supported-clis","content":"Supported CLIs"},"31":{"id":"/docs/features/agent-chat-2","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#available-models","content":"Available models"},"32":{"id":"/docs/features/agent-chat-3","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#starting-a-chat","content":"Starting a chat"},"33":{"id":"/docs/features/agent-chat-4","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#tool-use","content":"Tool use"},"34":{"id":"/docs/features/agent-chat-5","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#tool-approval","content":"Tool approval"},"35":{"id":"/docs/features/agent-chat-6","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#auto-approval-and-permission-modes","content":"Auto-approval and permission modes"},"36":{"id":"/docs/features/agent-chat-7","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#effort-level","content":"Effort level"},"37":{"id":"/docs/features/agent-chat-8","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#conversations","content":"Conversations"},"38":{"id":"/docs/features/agent-chat-9","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#forking","content":"Forking"},"39":{"id":"/docs/features/agent-chat-10","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#rich-content","content":"Rich content"},"40":{"id":"/docs/features/agent-chat-11","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#markdown-rendering","content":"Markdown rendering"},"41":{"id":"/docs/features/agent-chat-12","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#canvas-artifacts","content":"Canvas artifacts"},"42":{"id":"/docs/features/agent-chat-13","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#drawings-and-visual-prompts","content":"Drawings and visual prompts"},"43":{"id":"/docs/features/agent-chat-14","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#file-and-image-attachments","content":"File and image attachments"},"44":{"id":"/docs/features/agent-chat-15","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#slash-commands","content":"Slash commands"},"45":{"id":"/docs/features/agent-chat-16","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#mcp-connectors-in-agent-chat","content":"MCP connectors in agent chat"},"46":{"id":"/docs/features/agent-chat-17","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#remote-agent-chat","content":"Remote agent chat"},"47":{"id":"/docs/features/agent-chat-18","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#tips","content":"Tips"},"48":{"id":"/docs/features/agent-chat-19","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat","content":"Agent Chat lets you work with AI coding assistants directly inside Gent. Instead of switching between your terminal and a separate chat window, the agent runs alongside your other sessions — reading your files, executing commands, and making edits, all visible in real time."},"49":{"id":"/docs/features/agent-chat-20","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"CLI"},"50":{"id":"/docs/features/agent-chat-21","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Multi-turn"},"51":{"id":"/docs/features/agent-chat-22","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"How it connects"},"52":{"id":"/docs/features/agent-chat-23","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Claude Code"},"53":{"id":"/docs/features/agent-chat-24","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Yes (long-lived stdin)"},"54":{"id":"/docs/features/agent-chat-25","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Spawns process, sends messages via `--input-format stream-json`"},"55":{"id":"/docs/features/agent-chat-26","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Codex"},"56":{"id":"/docs/features/agent-chat-27","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"One-shot"},"57":{"id":"/docs/features/agent-chat-28","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Spawns a new process per message"},"58":{"id":"/docs/features/agent-chat-29","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Copilot"},"59":{"id":"/docs/features/agent-chat-30","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"One-shot"},"60":{"id":"/docs/features/agent-chat-31","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Spawns a new process per message"},"61":{"id":"/docs/features/agent-chat-32","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#supported-clis","content":"Claude Code keeps a persistent process running, so follow-up messages are instant. Codex and Copilot spawn fresh processes for each message, which takes a few seconds."},"62":{"id":"/docs/features/agent-chat-33","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Each CLI gives you access to different models:"},"63":{"id":"/docs/features/agent-chat-34","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"CLI"},"64":{"id":"/docs/features/agent-chat-35","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Models"},"65":{"id":"/docs/features/agent-chat-36","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Claude Code"},"66":{"id":"/docs/features/agent-chat-37","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Haiku 4.5, Sonnet 4.6, Opus 4.6"},"67":{"id":"/docs/features/agent-chat-38","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Codex"},"68":{"id":"/docs/features/agent-chat-39","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Codex Mini, GPT-5.2 Codex, o4-mini, o3"},"69":{"id":"/docs/features/agent-chat-40","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Copilot"},"70":{"id":"/docs/features/agent-chat-41","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"GPT-4o, Claude 3.5 Sonnet, o3-mini"},"71":{"id":"/docs/features/agent-chat-42","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#available-models","content":"Select your preferred model from the dropdown in the chat header. The model affects response quality, speed, and cost."},"72":{"id":"/docs/features/agent-chat-43","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#starting-a-chat","content":"Click &#x2A;*+** in the tab bar and select **Agent Chat**"},"73":{"id":"/docs/features/agent-chat-44","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#starting-a-chat","content":"Choose your CLI (Claude Code, Codex, or Copilot) from the dropdown"},"74":{"id":"/docs/features/agent-chat-45","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#starting-a-chat","content":"Type your message and press Enter"},"75":{"id":"/docs/features/agent-chat-46","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#starting-a-chat","content":"The agent streams its response in real time. You will see text output as it is generated, and tool use appears as interactive chips showing what the agent is doing."},"76":{"id":"/docs/features/agent-chat-47","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"When the agent calls tools — reading files, running commands, searching code — Gent shows each tool invocation with meaningful context:"},"77":{"id":"/docs/features/agent-chat-48","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"**Read file** shows the filename being read"},"78":{"id":"/docs/features/agent-chat-49","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"**Run command** shows the actual shell command"},"79":{"id":"/docs/features/agent-chat-50","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"**Search** shows the query being searched"},"80":{"id":"/docs/features/agent-chat-51","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"**Edit file** shows which file is being modified"},"81":{"id":"/docs/features/agent-chat-52","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-use","content":"Tool calls that modify files (edits, writes) are highlighted so you can review what changed. Gent generates inline diffs for file modifications."},"82":{"id":"/docs/features/agent-chat-53","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-approval","content":"Some tools require your approval before the agent can execute them. When the agent wants to run a potentially destructive action (like writing a file or running a shell command), Gent shows a permission prompt. You can:"},"83":{"id":"/docs/features/agent-chat-54","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-approval","content":"**Approve** the individual tool call"},"84":{"id":"/docs/features/agent-chat-55","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-approval","content":"**Approve all** for that tool type during the session"},"85":{"id":"/docs/features/agent-chat-56","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tool-approval","content":"**Reject** to deny the action"},"86":{"id":"/docs/features/agent-chat-57","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#auto-approval-and-permission-modes","content":"For trusted workflows, you can configure auto-approval in the chat settings. This lets the agent run tools without asking — useful when you are watching the output and want a faster feedback loop. You can set permission modes per tool category (e.g., always approve file reads, always ask before shell commands)."},"87":{"id":"/docs/features/agent-chat-58","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#effort-level","content":"Claude Code supports an effort setting that controls how thorough the agent is. Lower effort means faster, more concise responses. Higher effort means the agent spends more time thinking, reading more files, and producing more detailed output. Adjust this in the chat header."},"88":{"id":"/docs/features/agent-chat-59","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"Each agent chat is a persistent conversation. You can:"},"89":{"id":"/docs/features/agent-chat-60","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"**Continue** a conversation by sending more messages"},"90":{"id":"/docs/features/agent-chat-61","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"**Fork** a conversation to branch off from a specific point — useful when you want to try a different approach without losing the original thread"},"91":{"id":"/docs/features/agent-chat-62","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"**Resume** a previous conversation from the sidebar"},"92":{"id":"/docs/features/agent-chat-63","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#conversations","content":"Conversation history is stored locally on your desktop. Nothing is sent to any cloud service beyond what the underlying CLI itself sends to its API."},"93":{"id":"/docs/features/agent-chat-64","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#forking","content":"Conversation forking creates a new conversation that starts with the same history up to the point you forked. The original conversation is untouched. This lets you explore \"what if\" scenarios — try a different approach, and if it doesn't work out, go back to the original."},"94":{"id":"/docs/features/agent-chat-65","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#markdown-rendering","content":"Agent responses render full Markdown with syntax highlighting for code blocks, tables, lists, and inline formatting. Code blocks show the language label and can be copied with one click."},"95":{"id":"/docs/features/agent-chat-66","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#canvas-artifacts","content":"When an agent produces self-contained HTML/JS/CSS, Gent can display it in a Canvas panel alongside the chat. This is useful for visual content — charts, diagrams, interactive prototypes, games, and small tools — that the agent generates during the conversation. See Gent Canvas for the full workflow."},"96":{"id":"/docs/features/agent-chat-67","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#drawings-and-visual-prompts","content":"Gent Draw opens an Excalidraw board from the composer. You can sketch, paste images, annotate screenshots, reopen saved drawings, export the board, or send the drawing to the agent as a single PNG attachment. See Gent Draw."},"97":{"id":"/docs/features/agent-chat-68","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#file-and-image-attachments","content":"Drag and drop files or images into the composer, or paste them from your clipboard. The agent receives the file content as part of the message context. This works with code files, screenshots, logs, or any text-based content you want the agent to see."},"98":{"id":"/docs/features/agent-chat-69","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#slash-commands","content":"Type `/` in the composer to see available slash commands. These come from installed skills and built-in commands. Slash commands let you trigger specific workflows without typing out full prompts."},"99":{"id":"/docs/features/agent-chat-70","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#mcp-connectors-in-agent-chat","content":"If you have MCP connectors configured, the agent can use them as tools. For example, with the GitHub connector enabled, Claude Code can create pull requests, read issues, and manage repositories directly from chat."},"100":{"id":"/docs/features/agent-chat-71","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#mcp-connectors-in-agent-chat","content":"Gent generates an MCP config file that the CLI reads at startup, so all your connected integrations are available to the agent automatically."},"101":{"id":"/docs/features/agent-chat-72","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#remote-agent-chat","content":"Agent chat works from paired remote devices. When you select a remote device in the sidebar, you see its running agent chat sessions and can interact with them. The CLI process runs on the desktop — the remote device sends input and receives streamed output over the network."},"102":{"id":"/docs/features/agent-chat-73","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tips","content":"Long-running agent tasks keep working even if you switch to another tab"},"103":{"id":"/docs/features/agent-chat-74","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tips","content":"Use conversation forking when you want to try a different approach without losing the original thread"},"104":{"id":"/docs/features/agent-chat-75","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tips","content":"The agent respects your project's working directory when running commands"},"105":{"id":"/docs/features/agent-chat-76","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat#tips","content":"Use voice input to dictate prompts instead of typing"},"106":{"id":"/docs/features/canvas","page_id":"/docs/features/canvas","type":"page","content":"Gent Canvas","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/canvas"},"107":{"id":"/docs/features/canvas-0","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas","content":"Render agent-generated HTML, charts, prototypes, and interactive web artifacts beside chat."},"108":{"id":"/docs/features/canvas-1","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#what-canvas-is-for","content":"What Canvas is for"},"109":{"id":"/docs/features/canvas-2","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#starting-with-canvas","content":"Starting with `/canvas`"},"110":{"id":"/docs/features/canvas-3","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#file-mode-and-auto-reload","content":"File mode and auto-reload"},"111":{"id":"/docs/features/canvas-4","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#library-support","content":"Library support"},"112":{"id":"/docs/features/canvas-5","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#canvas-vs-web-preview","content":"Canvas vs Web Preview"},"113":{"id":"/docs/features/canvas-6","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#constraints","content":"Constraints"},"114":{"id":"/docs/features/canvas-7","page_id":"/docs/features/canvas","type":"heading","tags":[],"url":"/docs/features/canvas#related","content":"Related"},"115":{"id":"/docs/features/canvas-8","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas","content":"Gent Canvas gives agents a real web surface next to the conversation. When an agent needs to show something visual, it can call the built-in `mate-canvas` MCP tool and render a self-contained HTML document in the Canvas panel."},"116":{"id":"/docs/features/canvas-9","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas","content":"This is the web-agent surface in Gent: the agent writes the page, Gent renders it, and you can keep iterating without leaving the chat."},"117":{"id":"/docs/features/canvas-10","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Use Canvas when the output should be seen, touched, or inspected as a rendered web artifact:"},"118":{"id":"/docs/features/canvas-11","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Interactive prototypes and one-off UI mockups"},"119":{"id":"/docs/features/canvas-12","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Charts, dashboards, and data visualizations"},"120":{"id":"/docs/features/canvas-13","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Diagrams and system maps"},"121":{"id":"/docs/features/canvas-14","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Games, simulations, and small tools"},"122":{"id":"/docs/features/canvas-15","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"HTML/CSS/JS demos that benefit from live iteration"},"123":{"id":"/docs/features/canvas-16","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#what-canvas-is-for","content":"Canvas is not an image viewer. If an agent creates a PNG, SVG, JPEG, logo, screenshot, or icon file, it should attach or reference the file directly instead of opening it in Canvas."},"124":{"id":"/docs/features/canvas-17","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Type `/canvas` followed by what you want:"},"125":{"id":"/docs/features/canvas-18","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Gent rewrites that into a focused instruction for the agent:"},"126":{"id":"/docs/features/canvas-19","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Create a complete self-contained HTML file in the current working directory"},"127":{"id":"/docs/features/canvas-20","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Put CSS and JavaScript inline"},"128":{"id":"/docs/features/canvas-21","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Use CSS custom properties for important colors, fonts, and spacing"},"129":{"id":"/docs/features/canvas-22","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"Call `mcp__mate-canvas__show` with the generated file"},"130":{"id":"/docs/features/canvas-23","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#starting-with-canvas","content":"The Canvas panel opens beside the chat when the tool call completes."},"131":{"id":"/docs/features/canvas-24","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#file-mode-and-auto-reload","content":"Canvas supports inline HTML, but Gent prefers file mode for iterative work. The agent writes a file such as `canvas-a1b2c3d4.html`, then calls the show tool with:"},"132":{"id":"/docs/features/canvas-25","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#file-mode-and-auto-reload","content":"Follow-up `/canvas` messages are applied to the same file when possible. The panel auto-reloads after edits, so the agent does not need to call the show tool again for every tiny change."},"133":{"id":"/docs/features/canvas-26","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Canvas can load browser libraries from CDNs when the HTML needs them. Good fits include:"},"134":{"id":"/docs/features/canvas-27","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Need"},"135":{"id":"/docs/features/canvas-28","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Examples"},"136":{"id":"/docs/features/canvas-29","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"3D scenes"},"137":{"id":"/docs/features/canvas-30","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Three.js, Babylon.js"},"138":{"id":"/docs/features/canvas-31","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Charts"},"139":{"id":"/docs/features/canvas-32","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"D3, Chart.js, Plotly, ECharts"},"140":{"id":"/docs/features/canvas-33","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Maps"},"141":{"id":"/docs/features/canvas-34","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Leaflet, MapLibre GL"},"142":{"id":"/docs/features/canvas-35","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Animation"},"143":{"id":"/docs/features/canvas-36","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"GSAP, anime.js, Lottie"},"144":{"id":"/docs/features/canvas-37","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Audio"},"145":{"id":"/docs/features/canvas-38","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Tone.js, Howler.js"},"146":{"id":"/docs/features/canvas-39","page_id":"/docs/features/canvas","tags":[],"type":"text","url":"/docs/features/canvas#library-support","content":"Games and sketches"},"147":{"id":"/docs/feature