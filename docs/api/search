installed-skills","content":"**Update** a skill if a newer version is available in the marketplace"},"745":{"id":"/docs/integrations/skills-37","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#managing-installed-skills","content":"**View details** to see the full prompt template"},"746":{"id":"/docs/integrations/skills-38","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#custom-skills","content":"You can create your own skills by placing markdown files directly in `.mate/skills/` or the CLI-specific skill directories. Custom skills follow the same format as marketplace skills and appear alongside them in the slash command list."},"747":{"id":"/docs/integrations/skills-39","page_id":"/docs/integrations/skills","tags":[],"type":"text","url":"/docs/integrations/skills#custom-skills","content":"This is useful for team-specific workflows — write a skill once, share the file, and everyone on the team gets the same commands."},"748":{"id":"/docs/features/agent-chat","page_id":"/docs/features/agent-chat","type":"page","content":"Agent Chat","breadcrumbs":["Docs","Features"],"tags":[],"url":"/docs/features/agent-chat"},"749":{"id":"/docs/features/agent-chat-0","page_id":"/docs/features/agent-chat","tags":[],"type":"text","url":"/docs/features/agent-chat","content":"Chat with AI coding agents like Claude Code, Codex, and Copilot inside Gent."},"750":{"id":"/docs/features/agent-chat-1","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#supported-clis","content":"Supported CLIs"},"751":{"id":"/docs/features/agent-chat-2","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#available-models","content":"Available models"},"752":{"id":"/docs/features/agent-chat-3","page_id":"/docs/features/agent-chat","type":"heading","tags":[],"url":"/docs/features/agent-chat#starting-a-chat","content":"Starting a c